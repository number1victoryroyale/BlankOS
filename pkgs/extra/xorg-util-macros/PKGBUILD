# Maintainer: BlankOS <builds@blankos.invalid>
# Based on BLFS 13.1 (systemd)

pkgname=xorg-util-macros
pkgver=1.20.2
pkgrel=1
pkgdesc="X.Org Autotools macros"
arch=(any)
url='https://xorg.freedesktop.org/'
license=('MIT')
source=("https://www.x.org/pub/individual/util/util-macros-$pkgver.tar.xz")
sha256sums=('9ac269eba24f672d7d7b3574e4be5f333d13f04a7712303b1821b2a51ac82e8e')

build() {
	cd "util-macros-$pkgver"
	./configure --prefix=/usr --sysconfdir=/etc --localstatedir=/var --disable-static
}

package() {
	cd "util-macros-$pkgver"
	make DESTDIR="$pkgdir" install
}
