# Maintainer: BlankOS <builds@blankos.invalid>
# Based on BLFS 13.1 (systemd)

pkgname=alsa-lib
pkgver=1.2.16.1
pkgrel=1
pkgdesc="An alternative implementation of Linux sound support"
arch=(x86_64)
url='https://www.alsa-project.org/'
license=('LGPL-2.1-or-later')
depends=('glibc' 'alsa-ucm-conf' 'alsa-topology-conf')
source=("https://www.alsa-project.org/files/pub/lib/alsa-lib-$pkgver.tar.bz2")
sha256sums=('f740db7f488255944ffd4428416ee3390a96742856916433df468c281436480e')

build() {
	cd "$pkgname-$pkgver"
	./configure --prefix=/usr --without-debug
	make
}

package() {
	cd "$pkgname-$pkgver"
	make DESTDIR="$pkgdir" install
}
