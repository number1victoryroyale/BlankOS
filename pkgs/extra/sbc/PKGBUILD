# Maintainer: BlankOS <builds@blankos.invalid>
# Based on BLFS 13.1 (systemd)

pkgname=sbc
pkgver=2.2
pkgrel=1
pkgdesc="Bluetooth Subband Codec (SBC) library"
arch=(x86_64)
url='https://www.bluez.org/'
license=('GPL-2.0-or-later' 'LGPL-2.1-or-later')
depends=('glibc')
source=("https://www.kernel.org/pub/linux/bluetooth/sbc-$pkgver.tar.xz")
sha256sums=('a1ada76ef35e5af9c2fbd063754dc9e37a8d989417c6eb1ecebb089b1383ae9e')

build() {
	cd "$pkgname-$pkgver"
	./configure --prefix=/usr --disable-static --disable-tester
	make
}

package() {
	cd "$pkgname-$pkgver"
	make DESTDIR="$pkgdir" install
}
