# Maintainer: BlankOS <builds@blankos.invalid>
# Based on BLFS 13.1 (systemd)

pkgname=wpa_supplicant
pkgver=2.12
pkgrel=1
pkgdesc="Wi-Fi client (WPA2/WPA3, enterprise networks), driven by NetworkManager over D-Bus"
arch=(x86_64)
url='https://w1.fi/wpa_supplicant/'
license=('BSD-3-Clause')
depends=('openssl' 'libnl' 'dbus' 'readline')
source=("https://w1.fi/releases/wpa_supplicant-$pkgver.tar.gz")
sha256sums=('08e23937e16d0155e55cab2b51f51fbe10d80a1aa91c4e15442645059b737ef6')

prepare() {
	cd "$pkgname-$pkgver/wpa_supplicant"
	cat > .config << "EOF2"
CONFIG_BACKEND=file
CONFIG_CTRL_IFACE=y
CONFIG_CTRL_IFACE_DBUS_NEW=y
CONFIG_CTRL_IFACE_DBUS_INTRO=y
CONFIG_DEBUG_FILE=y
CONFIG_DEBUG_SYSLOG=y
CONFIG_DEBUG_SYSLOG_FACILITY=LOG_DAEMON
CONFIG_DRIVER_NL80211=y
CONFIG_DRIVER_WEXT=y
CONFIG_DRIVER_WIRED=y
CONFIG_EAP_GTC=y
CONFIG_EAP_LEAP=y
CONFIG_EAP_MD5=y
CONFIG_EAP_MSCHAPV2=y
CONFIG_EAP_OTP=y
CONFIG_EAP_PEAP=y
CONFIG_EAP_PWD=y
CONFIG_EAP_TLS=y
CONFIG_EAP_TTLS=y
CONFIG_IEEE8021X_EAPOL=y
CONFIG_IEEE80211N=y
CONFIG_IEEE80211AC=y
CONFIG_IEEE80211AX=y
CONFIG_IEEE80211W=y
CONFIG_SAE=y
CONFIG_OWE=y
CONFIG_SUITEB=y
CONFIG_SUITEB192=y
CONFIG_DPP=y
CONFIG_MBO=y
CONFIG_AP=y
CONFIG_P2P=y
CONFIG_WIFI_DISPLAY=y
CONFIG_BGSCAN_SIMPLE=y
CONFIG_IPV6=y
CONFIG_LIBNL32=y
CONFIG_PKCS12=y
CONFIG_READLINE=y
CONFIG_SMARTCARD=y
CONFIG_WPS=y
CFLAGS += -I/usr/include/libnl3
EOF2
}

build() {
	cd "$pkgname-$pkgver/wpa_supplicant"
	make BINDIR=/usr/sbin LIBDIR=/usr/lib
}

package() {
	cd "$pkgname-$pkgver/wpa_supplicant"
	install -Dm755 -t "$pkgdir/usr/sbin" wpa_cli wpa_passphrase wpa_supplicant
	install -Dm644 -t "$pkgdir/usr/share/man/man5" doc/docbook/wpa_supplicant.conf.5
	install -Dm644 -t "$pkgdir/usr/share/man/man8" doc/docbook/wpa_{cli,passphrase,supplicant}.8
	install -Dm644 -t "$pkgdir/usr/lib/systemd/system" systemd/*.service
	install -Dm644 dbus/fi.w1.wpa_supplicant1.service "$pkgdir/usr/share/dbus-1/system-services/fi.w1.wpa_supplicant1.service"
	install -Dm644 dbus/dbus-wpa_supplicant.conf "$pkgdir/usr/share/dbus-1/system.d/wpa_supplicant.conf"
	install -Dm644 ../COPYING "$pkgdir/usr/share/licenses/$pkgname/COPYING"
}
