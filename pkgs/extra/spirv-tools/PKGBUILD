# Maintainer: BlankOS <builds@blankos.invalid>
# Based on BLFS 13.1 (systemd)

pkgname=spirv-tools
pkgver=1.4.357.0
pkgrel=1
pkgdesc="API and commands for processing SPIR-V modules"
arch=(x86_64)
url='https://www.khronos.org/vulkan/'
license=('Apache-2.0')
depends=('gcc-libs')
makedepends=('cmake' 'ninja' 'python' 'spirv-headers')
source=("SPIRV-Tools-vulkan-sdk-$pkgver.tar.gz::https://github.com/KhronosGroup/SPIRV-Tools/archive/vulkan-sdk-$pkgver/SPIRV-Tools-vulkan-sdk-$pkgver.tar.gz")
sha256sums=('d31e7109b6ef3559067e53e520870eafed7c9534d00db9728814b6df03fa4a5e')

build() {
	cmake -S "SPIRV-Tools-vulkan-sdk-$pkgver" -B build -G Ninja \
		-D CMAKE_INSTALL_PREFIX=/usr -D CMAKE_BUILD_TYPE=Release \
		-D SPIRV_WERROR=OFF -D BUILD_SHARED_LIBS=ON -D SPIRV_TOOLS_BUILD_STATIC=OFF \
		-D SPIRV_SKIP_TESTS=ON -D SPIRV-Headers_SOURCE_DIR=/usr
	ninja -C build
}

package() {
	DESTDIR="$pkgdir" ninja -C build install
}
