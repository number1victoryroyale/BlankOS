# Maintainer: BlankOS <builds@blankos.invalid>
# Based on Arch Linux's liblc3 package (not in BLFS)

pkgname=liblc3
pkgver=1.1.3
pkgrel=1
pkgdesc="Low Complexity Communication Codec (LE Audio and wideband headset mics)"
arch=(x86_64)
url='https://github.com/google/liblc3'
license=('Apache-2.0')
depends=('glibc')
source=("liblc3-$pkgver.tar.gz::https://github.com/google/liblc3/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('276752ff54ce6a77d54ec133397b9d7e71f90caf3d9afa32d8b0e891b8ecb8af')

build() {
	meson setup build "liblc3-$pkgver" --prefix=/usr --buildtype=release -D python=false -D tools=true
	ninja -C build
}

package() {
	DESTDIR="$pkgdir" ninja -C build install
}
