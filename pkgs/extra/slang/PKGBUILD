# Maintainer: BlankOS <builds@blankos.invalid>
# Based on BLFS 13.1 (systemd)

pkgname=slang
pkgver=2.3.3
pkgrel=1
pkgdesc="S-Lang is a powerful interpreted language"
arch=(x86_64)
url='https://www.jedsoft.org/slang/'
license=('GPL-2.0-or-later')
depends=('glibc' 'pcre2' 'zlib' 'readline')
source=("https://www.jedsoft.org/releases/slang/slang-$pkgver.tar.bz2")
sha256sums=('f9145054ae131973c61208ea82486d5dd10e3c5cdad23b7c4a0617743c8f5a18')

build() {
	cd "$pkgname-$pkgver"
	./configure --prefix=/usr --sysconfdir=/etc --with-readline=gnu
	make -j1 RPATH=
}

package() {
	cd "$pkgname-$pkgver"
	make -j1 DESTDIR="$pkgdir" RPATH= install_doc_dir=/usr/share/doc/slang SLSH_DOC_DIR=/usr/share/doc/slang/slsh install-all
	chmod 755 "$pkgdir"/usr/lib/libslang.so.* "$pkgdir"/usr/lib/slang/v2/modules/*.so
}
