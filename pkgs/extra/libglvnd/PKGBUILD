# Maintainer: BlankOS <builds@blankos.invalid>
# Based on Arch Linux's libglvnd package (not in BLFS)

pkgname=libglvnd
pkgver=1.7.0
pkgrel=1
pkgdesc="The GL Vendor-Neutral Dispatch library"
arch=(x86_64)
url='https://gitlab.freedesktop.org/glvnd/libglvnd'
license=('custom:BSD-like')
depends=('libxext' 'libx11')
makedepends=('xorgproto' 'python')
provides=('libgl' 'libegl' 'libgles')
source=("https://gitlab.freedesktop.org/glvnd/libglvnd/-/archive/v$pkgver/libglvnd-v$pkgver.tar.gz")
sha256sums=('2b6e15b06aafb4c0b6e2348124808cbd9b291c647299eaaba2e3202f51ff2f3d')

build() {
	meson setup build "libglvnd-v$pkgver" --prefix=/usr --buildtype=release -D gles1=false
	ninja -C build
}

package() {
	DESTDIR="$pkgdir" ninja -C build install
	install -Dm644 "libglvnd-v$pkgver/README.md" "$pkgdir/usr/share/licenses/$pkgname/README.md"
}
