# Maintainer: BlankOS <builds@blankos.invalid>
# Based on BLFS 13.1 (systemd)

pkgname=pciutils
pkgver=3.15.0
pkgrel=1
pkgdesc="PCI bus configuration space access library and tools (lspci)"
arch=(x86_64)
url='https://mj.ucw.cz/sw/pciutils/'
license=('GPL-2.0-or-later')
depends=('glibc' 'hwdata' 'kmod' 'zlib')
source=("https://mj.ucw.cz/download/linux/pci/pciutils-$pkgver.tar.gz")
sha256sums=('a42e6e3f76fb6b1f6ac2e08cdd151f6bf78bc4f6312c591f4b6ec197582ede3a')

prepare() {
	cd "$pkgname-$pkgver"
	sed -r '/INSTALL/{/PCI_IDS|update-pciids /d; s/update-pciids.8//}' -i Makefile
}

build() {
	cd "$pkgname-$pkgver"
	make PREFIX=/usr SHAREDIR=/usr/share/hwdata SHARED=yes
}

package() {
	cd "$pkgname-$pkgver"
	make PREFIX=/usr SHAREDIR=/usr/share/hwdata SHARED=yes DESTDIR="$pkgdir" install install-lib
	chmod 755 "$pkgdir"/usr/lib/libpci.so*
}
