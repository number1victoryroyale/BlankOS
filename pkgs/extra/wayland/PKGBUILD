# Maintainer: BlankOS <builds@blankos.invalid>
# Based on BLFS 13.1 (systemd)

pkgname=wayland
pkgver=1.26.0
pkgrel=1
pkgdesc="A computer graphics protocol for display servers"
arch=(x86_64)
url='https://wayland.freedesktop.org/'
license=('MIT')
depends=('glibc' 'libffi' 'expat' 'libxml2')
source=("https://gitlab.freedesktop.org/wayland/wayland/-/releases/$pkgver/downloads/wayland-$pkgver.tar.xz")
sha256sums=('64176eaa46e4969903e286f8e5ef8331affc17fdf03ac9b58381d2b23162b7a3')

build() {
	meson setup build "$pkgname-$pkgver" --prefix=/usr --buildtype=release \
		-D documentation=false -D tests=false
	ninja -C build
}

package() {
	DESTDIR="$pkgdir" ninja -C build install
}
