# Maintainer: BlankOS <builds@blankos.invalid>
# Based on BLFS 13.1 (systemd)

pkgname=newt
pkgver=0.52.25
pkgrel=1
pkgdesc="Not Erik's Windowing Toolkit - text mode windowing with slang (for nmtui)"
arch=(x86_64)
url='https://pagure.io/newt'
license=('LGPL-2.0-only')
depends=('slang' 'popt')
source=("https://releases.pagure.org/newt/newt-$pkgver.tar.gz")
sha256sums=('ef0ca9ee27850d1a5c863bb7ff9aa08096c9ed312ece9087b30f3a426828de82')

prepare() {
	cd "$pkgname-$pkgver"
	sed -e '/install -m 644 $(LIBNEWT)/ s/^/#/' \
		-e '/$(LIBNEWT):/,/rv/ s/^/#/' \
		-e 's/$(LIBNEWT)/$(LIBNEWTSH)/g' \
		-i Makefile.in
}

build() {
	cd "$pkgname-$pkgver"
	./configure --prefix=/usr --without-gpm-support --without-python --without-tcl
	make
}

package() {
	cd "$pkgname-$pkgver"
	make DESTDIR="$pkgdir" install
}
