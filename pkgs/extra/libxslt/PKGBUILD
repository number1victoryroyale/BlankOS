# Maintainer: BlankOS <builds@blankos.invalid>
# Based on BLFS 13.1 (systemd)

pkgname=libxslt
pkgver=1.1.45
pkgrel=1
pkgdesc="XML stylesheet transformation library"
arch=(x86_64)
url='https://gitlab.gnome.org/GNOME/libxslt'
license=('MIT')
depends=('libxml2' 'libgcrypt')
source=("https://download.gnome.org/sources/libxslt/${pkgver%.*}/libxslt-$pkgver.tar.xz")
sha256sums=('9acfe68419c4d06a45c550321b3212762d92f41465062ca4ea19e632ee5d216e')

build() {
	cd "$pkgname-$pkgver"
	./configure --prefix=/usr --disable-static --without-python
	make
}

package() {
	cd "$pkgname-$pkgver"
	make DESTDIR="$pkgdir" install
}
