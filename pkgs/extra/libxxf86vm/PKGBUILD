# Maintainer: BlankOS <builds@blankos.invalid>
# Based on BLFS 13.1 (systemd)

pkgname=libxxf86vm
pkgver=1.1.7
pkgrel=1
pkgdesc="X11 XFree86 video mode extension library"
arch=(x86_64)
url='https://xorg.freedesktop.org/'
license=('MIT')
depends=('libxext')
makedepends=('xorgproto' 'xorg-util-macros')
source=("https://www.x.org/pub/individual/lib/libXxf86vm-$pkgver.tar.xz")
sha256sums=('ae50c0f669e0af5a67cc4cd0f54f21d64a64d2660af883e80e95d3fe51b945d8')

build() {
	cd "libXxf86vm-$pkgver"
	./configure --prefix=/usr --sysconfdir=/etc --localstatedir=/var --disable-static
	make
}

package() {
	cd "libXxf86vm-$pkgver"
	make DESTDIR="$pkgdir" install
}
