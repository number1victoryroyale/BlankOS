# Maintainer: BlankOS <builds@blankos.invalid>
# Based on BLFS 13.1 (systemd)

pkgname=libxext
pkgver=1.3.7
pkgrel=1
pkgdesc="X11 miscellaneous extensions library"
arch=(x86_64)
url='https://xorg.freedesktop.org/'
license=('MIT')
depends=('libx11')
makedepends=('xorgproto' 'xorg-util-macros')
source=("https://www.x.org/pub/individual/lib/libXext-$pkgver.tar.xz")
sha256sums=('6c643c7035cdacf67afd68f25d01b90ef889d546c9fcd7c0adf7c2cf91e3a32d')

build() {
	cd "libXext-$pkgver"
	./configure --prefix=/usr --sysconfdir=/etc --localstatedir=/var --disable-static
	make
}

package() {
	cd "libXext-$pkgver"
	make DESTDIR="$pkgdir" install
}
