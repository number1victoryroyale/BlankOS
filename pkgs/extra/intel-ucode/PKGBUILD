# Maintainer: BlankOS <builds@blankos.invalid>
# Based on Arch Linux's intel-ucode package (not in BLFS)

pkgname=intel-ucode
pkgver=20260925
pkgrel=1
pkgdesc="Microcode update image for Intel CPUs (loaded early by the boot loader)"
arch=(any)
url='https://github.com/intel/Intel-Linux-Processor-Microcode-Data-Files'
license=('LicenseRef-Intel')
makedepends=('libarchive')
source=("intel-ucode-$pkgver.tar.gz::https://github.com/intel/Intel-Linux-Processor-Microcode-Data-Files/archive/refs/tags/microcode-$pkgver.tar.gz")
sha256sums=('0ec19023dad1e6dd0c5909174b8dff2555b91cf01671e36271a1ef36655c0cfc')

build() {
	cd "Intel-Linux-Processor-Microcode-Data-Files-microcode-$pkgver"
	rm -rf kernel
	mkdir -p kernel/x86/microcode
	cat intel-ucode/* > kernel/x86/microcode/GenuineIntel.bin
	bsdtar --format newc --uid 0 --gid 0 -cf intel-ucode.img kernel
}

package() {
	cd "Intel-Linux-Processor-Microcode-Data-Files-microcode-$pkgver"
	install -Dm644 intel-ucode.img "$pkgdir/boot/intel-ucode.img"
	install -Dm644 license "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
