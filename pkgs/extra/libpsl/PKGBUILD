# Maintainer: BlankOS <builds@blankos.invalid>
# Based on BLFS 13.1 (systemd)

pkgname=libpsl
pkgver=0.23.3
pkgrel=1
pkgdesc="Public Suffix List library"
arch=(x86_64)
url='https://github.com/rockdaboot/libpsl'
license=('MIT')
depends=('libidn2' 'libunistring')
source=("https://github.com/rockdaboot/libpsl/releases/download/$pkgver/libpsl-$pkgver.tar.gz")
sha256sums=('93941f85a1e7bd593fa94f299233cb5dfc91cd144fd9a78a6ceb75001c5b03be')

build() {
	meson setup build "$pkgname-$pkgver" --prefix=/usr --buildtype=release -D tests=false -D docs=false
	ninja -C build
}

package() {
	DESTDIR="$pkgdir" ninja -C build install
}
