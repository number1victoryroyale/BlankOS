# Maintainer: BlankOS <builds@blankos.invalid>
# Based on BLFS 13.1 (systemd)

pkgname=alsa-utils
pkgver=1.2.16
pkgrel=1
pkgdesc="Advanced Linux Sound Architecture - Utilities (alsamixer, aplay, alsactl)"
arch=(x86_64)
url='https://www.alsa-project.org/'
license=('GPL-2.0-or-later')
depends=('alsa-lib' 'ncurses' 'systemd')
source=("https://www.alsa-project.org/files/pub/utils/alsa-utils-$pkgver.tar.bz2")
sha256sums=('092399d5e8749a1d5e188e393157521cec4b75693b60ebb79bbce728cff2232c')

build() {
	cd "$pkgname-$pkgver"
	./configure --prefix=/usr --disable-alsaconf --disable-bat --disable-xmlto \
		--with-curses=ncursesw --with-udev-rules-dir=/usr/lib/udev/rules.d \
		--with-systemdsystemunitdir=/usr/lib/systemd/system
	make
}

package() {
	cd "$pkgname-$pkgver"
	make DESTDIR="$pkgdir" install
	install -d "$pkgdir/var/lib/alsa"
}
