# Maintainer: BlankOS <builds@blankos.invalid>
# Based on Arch Linux's sof-firmware package (not in BLFS)

pkgname=sof-firmware
pkgver=2026.09.2
pkgrel=1
pkgdesc="Sound Open Firmware: audio DSP firmware for recent Intel laptops"
arch=(any)
url='https://www.sofproject.org/'
license=('BSD-3-Clause' 'custom')
source=("https://github.com/thesofproject/sof-bin/releases/download/v$pkgver/sof-bin-$pkgver.tar.gz")
sha256sums=('5f7bc30b2b5c1e6b0da55a33fc44e2b7f56ae9b06952edcde614f51ef6b943e1')

package() {
	cd "sof-bin-$pkgver"
	install -d "$pkgdir/usr/lib/firmware/intel"
	# sof, sof-tplg, sof-ipc4, sof-ipc4-lib, sof-ipc4-tplg, ...
	for d in sof*/; do
		cp -a "${d%/}" "$pkgdir/usr/lib/firmware/intel/"
	done
	install -Dm644 LICENCE.Intel "$pkgdir/usr/share/licenses/$pkgname/LICENCE.Intel"
	if [[ -f LICENCE.NXP ]]; then install -Dm644 LICENCE.NXP "$pkgdir/usr/share/licenses/$pkgname/LICENCE.NXP"; fi
}
