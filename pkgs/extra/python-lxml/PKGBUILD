# Maintainer: BlankOS <builds@blankos.invalid>
# Based on BLFS 13.1 (systemd)

pkgname=python-lxml
pkgver=6.1.1
pkgrel=1
pkgdesc="Python binding for the libxml2 and libxslt libraries"
arch=(x86_64)
url='https://lxml.de/'
license=('BSD-3-Clause')
depends=('python' 'libxml2' 'libxslt')
source=("https://files.pythonhosted.org/packages/source/l/lxml/lxml-$pkgver.tar.gz")
sha256sums=('ba96ae44888e0185281e937633a743ea90d5a196c6000f82565ebb0580012d40')

build() {
	cd "lxml-$pkgver"
	pip3 wheel -w dist --no-cache-dir --no-build-isolation --no-deps "$PWD"
}

package() {
	cd "lxml-$pkgver"
	pip3 install --root="$pkgdir" --no-index --find-links dist \
		--no-deps --ignore-installed --no-cache-dir --no-warn-script-location lxml
}
