# Maintainer: BlankOS <builds@blankos.invalid>
# Based on BLFS 13.1 (systemd)

pkgname=python-pyparsing
pkgver=3.3.2
pkgrel=1
pkgdesc="General parsing module for Python"
arch=(any)
url='https://github.com/pyparsing/pyparsing'
license=('MIT')
depends=('python')
source=("https://files.pythonhosted.org/packages/source/p/pyparsing/pyparsing-$pkgver.tar.gz")
sha256sums=('c777f4d763f140633dcb6d8a3eda953bf7a214dc4eff598413c070bcdc117cbc')

build() {
	cd "pyparsing-$pkgver"
	pip3 wheel -w dist --no-cache-dir --no-build-isolation --no-deps "$PWD"
}

package() {
	cd "pyparsing-$pkgver"
	pip3 install --root="$pkgdir" --no-index --find-links dist \
		--no-deps --ignore-installed --no-cache-dir --no-warn-script-location pyparsing
}
