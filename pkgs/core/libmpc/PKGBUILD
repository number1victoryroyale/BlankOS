# Maintainer: BlankOS <builds@blankos.invalid>
# Based on LFS 13.1 §8.25

pkgname=libmpc
pkgver=1.4.1
pkgrel=2
pkgdesc="Library for the arithmetic of complex numbers with arbitrarily high precision"
arch=(x86_64)
url='https://www.multiprecision.org/'
license=('LGPL-3.0-or-later')
depends=('mpfr')
source=("https://ftpmirror.gnu.org/mpc/mpc-$pkgver.tar.xz")
sha256sums=('91204cd32f164bd3b7c992d4a6a8ce6519511aadab30f78b6982d0bf8d73e931')

build() {
	cd "mpc-$pkgver"
	./configure --prefix=/usr --disable-static --docdir=/usr/share/doc/mpc-$pkgver
	make
}

package() {
	cd "mpc-$pkgver"
	make DESTDIR="$pkgdir" install
}
