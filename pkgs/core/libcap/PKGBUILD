# Maintainer: BlankOS <builds@blankos.invalid>
# Based on LFS 13.1 §8.28

pkgname=libcap
pkgver=2.78
pkgrel=2
pkgdesc="POSIX 1003.1e capabilities"
arch=(x86_64)
url='https://sites.google.com/site/fullycapable/'
license=('BSD-3-Clause' 'GPL-2.0-only')
depends=('glibc')
source=("https://www.kernel.org/pub/linux/libs/security/linux-privs/libcap2/libcap-$pkgver.tar.xz")
sha256sums=('0d621e562fd932ccf67b9660fb018e468a683d7b827541df27813228c996bb11')

prepare() {
	cd "$pkgname-$pkgver"
	sed -i '/install -m.*STA/d' libcap/Makefile
}

build() {
	cd "$pkgname-$pkgver"
	make prefix=/usr lib=lib
}

package() {
	cd "$pkgname-$pkgver"
	make prefix=/usr lib=lib DESTDIR="$pkgdir" RAISE_SETFCAP=no install
}
