# Maintainer: BlankOS <builds@blankos.invalid>
# Based on BLFS 13.1 (systemd)

pkgname=pinentry
pkgver=1.3.3
pkgrel=1
pkgdesc="Collection of simple PIN or passphrase entry dialogs (terminal versions)"
arch=(x86_64)
url='https://www.gnupg.org/related_software/pinentry/'
license=('GPL-2.0-or-later')
depends=('glibc' 'ncurses' 'libassuan' 'libgpg-error')
source=("https://www.gnupg.org/ftp/gcrypt/pinentry/pinentry-$pkgver.tar.bz2")
sha256sums=('c2970f16d6afb66ecddfca767d743936c86239bff936eed7fd7597a678414b63')

build() {
	cd "$pkgname-$pkgver"
	# terminal front ends only; the Qt one comes with the desktop
	./configure --prefix=/usr --enable-pinentry-tty --enable-pinentry-curses \
		--disable-pinentry-qt --disable-pinentry-qt5 --disable-pinentry-gtk2 \
		--disable-pinentry-gnome3 --disable-pinentry-fltk --disable-pinentry-efl \
		--disable-libsecret
	make
}

package() {
	cd "$pkgname-$pkgver"
	make DESTDIR="$pkgdir" install
}
