# Maintainer: BlankOS <builds@blankos.invalid>
# Based on BLFS 13.1 (systemd)

pkgname=libksba
pkgver=1.8.0
pkgrel=1
pkgdesc="Library for working with X.509 certificates, CMS data and related objects"
arch=(x86_64)
url='https://www.gnupg.org/related_software/libksba/'
license=('LGPL-3.0-or-later OR GPL-2.0-or-later')
depends=('glibc' 'libgpg-error')
source=("https://www.gnupg.org/ftp/gcrypt/libksba/libksba-$pkgver.tar.bz2")
sha256sums=('296b9db9095749f2aa104202d7ab7fd09ad10710e00780a709c9754b1a1d9292')

build() {
	cd "$pkgname-$pkgver"
	./configure --prefix=/usr --disable-static
	make
}

package() {
	cd "$pkgname-$pkgver"
	make DESTDIR="$pkgdir" install
}
