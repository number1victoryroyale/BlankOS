# Maintainer: BlankOS <builds@blankos.invalid>

pkgname=blankos-settings
pkgver=0.1.0
pkgrel=1
pkgdesc="BlankOS default system configuration"
arch=(any)
url='https://github.com/number1victoryroyale/BlankOS'
license=('GPL-3.0-or-later')
depends=('systemd')
backup=('etc/locale.conf' 'etc/vconsole.conf' 'etc/hostname')
source=("80-blankos.preset"
        "80-blankos-wired.network"
        "locale.conf"
        "vconsole.conf"
        "50-blankos-gaming.conf")
sha256sums=('f9e5a505b22b0e340180c32bf20b4d9c4c079ac2d151ea28591b9dd9875f94a0'
            '48dec8bc41cda7153184cc8015e2f685695d210ade50b4ed100784093c2b34be'
            '033252d5100cbb0028d7c15e075f63e4eb5ff7f1a923cd5cb547bcfd6b024f5b'
            '2c09b43e51de87a82ff5eeb1c599ce25800b8d34810f14044bf73644e9f7b742'
            '740691bcfa46a04bf644e81a170ed138544b1319a8d961e8465ca0877a767bd4')

package() {
	install -Dm644 "$srcdir/80-blankos.preset" "$pkgdir/usr/lib/systemd/system-preset/80-blankos.preset"
	install -Dm644 "$srcdir/80-blankos-wired.network" "$pkgdir/usr/lib/systemd/network/80-blankos-wired.network"
	install -Dm644 "$srcdir/locale.conf" "$pkgdir/etc/locale.conf"
	install -Dm644 "$srcdir/vconsole.conf" "$pkgdir/etc/vconsole.conf"
	echo blankos > "$srcdir/hostname"
	install -Dm644 "$srcdir/hostname" "$pkgdir/etc/hostname"
	install -Dm644 "$srcdir/50-blankos-gaming.conf" "$pkgdir/usr/lib/sysctl.d/50-blankos-gaming.conf"
	# getty on tty1 keeps the boot messages (LFS 9.10)
	install -Dm644 /dev/stdin "$pkgdir/usr/lib/systemd/system/getty@tty1.service.d/noclear.conf" << EOF
[Service]
TTYVTDisallocate=no
EOF
}
