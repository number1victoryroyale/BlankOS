# Maintainer: BlankOS <builds@blankos.invalid>
# Based on LFS 13.1 §8.37

pkgname=bison
pkgver=3.8.2
pkgrel=1
pkgdesc="The GNU general-purpose parser generator"
arch=(x86_64)
url='https://www.gnu.org/software/bison/'
license=('GPL-3.0-or-later')
depends=('glibc' 'm4' 'sh')
source=("https://ftpmirror.gnu.org/bison/bison-$pkgver.tar.xz")
sha256sums=('9bba0214ccf7f1079c5d59210045227bcf619519840ebfa80cd3849cff5a5bf2')

build() {
	cd "$pkgname-$pkgver"
	./configure --prefix=/usr --docdir=/usr/share/doc/bison-$pkgver
	make
}

package() {
	cd "$pkgname-$pkgver"
	make DESTDIR="$pkgdir" install
}
