# Maintainer: BlankOS <builds@blankos.invalid>
# Based on LFS 13.1 §8.42

pkgname=gperf
pkgver=3.3
pkgrel=1
pkgdesc="Perfect hash function generator"
arch=(x86_64)
url='https://www.gnu.org/software/gperf/'
license=('GPL-3.0-or-later')
depends=('glibc' 'gcc')
source=("https://ftpmirror.gnu.org/gperf/gperf-$pkgver.tar.gz")
sha256sums=('fd87e0aba7e43ae054837afd6cd4db03a3f2693deb3619085e6ed9d8d9604ad8')

build() {
	cd "$pkgname-$pkgver"
	./configure --prefix=/usr --docdir=/usr/share/doc/gperf-$pkgver
	make
}

package() {
	cd "$pkgname-$pkgver"
	make DESTDIR="$pkgdir" install
}
