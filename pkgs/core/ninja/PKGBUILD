# Maintainer: BlankOS <builds@blankos.invalid>
# Based on LFS 13.1 §8.20

pkgname=ninja
pkgver=1.13.2
pkgrel=1
pkgdesc="Small build system with a focus on speed"
arch=(x86_64)
url='https://ninja-build.org'
license=('Apache-2.0')
depends=('glibc' 'gcc')
makedepends=('python')
source=("ninja-$pkgver.tar.gz::https://github.com/ninja-build/ninja/archive/v$pkgver/ninja-$pkgver.tar.gz")
sha256sums=('974d6b2f4eeefa25625d34da3cb36bdcebe7fbce40f4c16ac0835fd1c0cbae17')

prepare() {
	cd "$pkgname-$pkgver"
	# honour NINJAJOBS (LFS 8.20)
	sed -i '/int Guess/a \
  int   j = 0;\
  char* jobs = getenv( "NINJAJOBS" );\
  if ( jobs != NULL ) j = atoi( jobs );\
  if ( j > 0 ) return j;\
' src/ninja.cc
}

build() {
	cd "$pkgname-$pkgver"
	python3 configure.py --bootstrap --verbose
}

package() {
	cd "$pkgname-$pkgver"
	install -Dm755 ninja "$pkgdir/usr/bin/ninja"
	install -Dm644 misc/bash-completion "$pkgdir/usr/share/bash-completion/completions/ninja"
	install -Dm644 misc/zsh-completion "$pkgdir/usr/share/zsh/site-functions/_ninja"
}
