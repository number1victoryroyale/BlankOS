# Maintainer: BlankOS <builds@blankos.invalid>
# Based on LFS 13.1 §8.45

pkgname=less
pkgver=704
pkgrel=2
pkgdesc="A terminal based program for viewing text files"
arch=(x86_64)
url='https://www.greenwoodsoftware.com/less/'
license=('GPL-3.0-or-later' 'BSD-2-Clause')
depends=('glibc' 'ncurses' 'pcre2')
source=("https://www.greenwoodsoftware.com/less/less-$pkgver.tar.gz")
sha256sums=('20a0b0a2bb2525fa53c7eee9beb854b4c9cf172eabb209af7020743547bfe9fb')

build() {
	cd "$pkgname-$pkgver"
	./configure --prefix=/usr --sysconfdir=/etc
	make
}

package() {
	cd "$pkgname-$pkgver"
	make DESTDIR="$pkgdir" install
}
