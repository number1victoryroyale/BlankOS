# Based on LFS 13.1 §8.4

pkgname=iana-etc
pkgver=20260805
pkgrel=1
pkgdesc="/etc/protocols and /etc/services provided by IANA"
arch=(any)
url='https://github.com/Mic92/iana-etc'
license=('MIT')
backup=('etc/services' 'etc/protocols')
source=("https://github.com/Mic92/iana-etc/releases/download/$pkgver/iana-etc-$pkgver.tar.gz")
sha256sums=('29270860664e324107537f32ea476a333ca52d71b59c74bc06ecc3b0fa9cf490')

package() {
	cd "$pkgname-$pkgver"
	install -Dm644 -t "$pkgdir/etc" services protocols
}
