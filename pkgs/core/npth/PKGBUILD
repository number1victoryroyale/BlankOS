# Maintainer: BlankOS <builds@blankos.invalid>
# Based on BLFS 13.1 (systemd)

pkgname=npth
pkgver=1.8
pkgrel=1
pkgdesc="The new portable threads library"
arch=(x86_64)
url='https://www.gnupg.org/related_software/npth/'
license=('LGPL-2.0-or-later')
depends=('glibc')
source=("https://www.gnupg.org/ftp/gcrypt/npth/npth-$pkgver.tar.bz2")
sha256sums=('8bd24b4f23a3065d6e5b26e98aba9ce783ea4fd781069c1b35d149694e90ca3e')

build() {
	cd "$pkgname-$pkgver"
	./configure --prefix=/usr --disable-static
	make
}

package() {
	cd "$pkgname-$pkgver"
	make DESTDIR="$pkgdir" install
}
