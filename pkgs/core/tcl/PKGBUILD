# Maintainer: BlankOS <builds@blankos.invalid>
# Based on LFS 13.1 §8.17

pkgname=tcl
pkgver=8.6.18
pkgrel=2
pkgdesc="The Tcl scripting language"
arch=(x86_64)
url='https://www.tcl.tk'
license=('TCL')
depends=('glibc' 'zlib')
options=('staticlibs')
source=("https://downloads.sourceforge.net/tcl/tcl$pkgver-src.tar.gz")
sha256sums=('14f9af32b1767ff718477a8f974ad03c34341097e6b43f4ce54644ee974e268e')

build() {
	cd "tcl$pkgver"
	local srcroot=$(pwd)
	cd unix
	./configure --prefix=/usr --mandir=/usr/share/man --disable-rpath
	make
	sed -e "s|$srcroot/unix|/usr/lib|" \
		-e "s|$srcroot|/usr/include|" \
		-i tclConfig.sh
	sed -e "s|$srcroot/unix/pkgs/tdbc1.1.13|/usr/lib/tdbc1.1.13|" \
		-e "s|$srcroot/pkgs/tdbc1.1.13/generic|/usr/include|" \
		-e "s|$srcroot/pkgs/tdbc1.1.13/library|/usr/lib/tcl8.6|" \
		-e "s|$srcroot/pkgs/tdbc1.1.13|/usr/include|" \
		-i pkgs/tdbc1.1.13/tdbcConfig.sh
	sed -e "s|$srcroot/unix/pkgs/itcl4.3.7|/usr/lib/itcl4.3.7|" \
		-e "s|$srcroot/pkgs/itcl4.3.7/generic|/usr/include|" \
		-e "s|$srcroot/pkgs/itcl4.3.7|/usr/include|" \
		-i pkgs/itcl4.3.7/itclConfig.sh
}

package() {
	cd "tcl$pkgver/unix"
	make DESTDIR="$pkgdir" install
	chmod 644 "$pkgdir/usr/lib/libtclstub8.6.a"
	chmod -v u+w "$pkgdir/usr/lib/libtcl8.6.so"
	make DESTDIR="$pkgdir" install-private-headers
	ln -sfv tclsh8.6 "$pkgdir/usr/bin/tclsh"
	mv -v "$pkgdir"/usr/share/man/man3/{Thread,Tcl_Thread}.3
}
