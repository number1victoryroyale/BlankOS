# Maintainer: BlankOS <builds@blankos.invalid>
# Based on LFS 13.1 §8.38

pkgname=grep
pkgver=3.12
pkgrel=1
pkgdesc="A string search utility"
arch=(x86_64)
url='https://www.gnu.org/software/grep/'
license=('GPL-3.0-or-later')
depends=('glibc' 'pcre2')
source=("https://ftpmirror.gnu.org/grep/grep-$pkgver.tar.xz")
sha256sums=('2649b27c0e90e632eadcd757be06c6e9a4f48d941de51e7c0f83ff76408a07b9')

prepare() {
	cd "$pkgname-$pkgver"
	sed -i "s/echo/#echo/" src/egrep.sh
}

build() {
	cd "$pkgname-$pkgver"
	./configure --prefix=/usr
	make
}

package() {
	cd "$pkgname-$pkgver"
	make DESTDIR="$pkgdir" install
}
