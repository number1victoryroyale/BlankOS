# Maintainer: BlankOS <builds@blankos.invalid>
# Based on LFS 13.1 §8.53

pkgname=mpdecimal
pkgver=4.0.1
pkgrel=2
pkgdesc="Package for correctly-rounded arbitrary precision decimal floating point arithmetic"
arch=(x86_64)
url='https://www.bytereef.org/mpdecimal/'
license=('BSD-2-Clause')
depends=('glibc' 'gcc')
source=("https://www.bytereef.org/software/mpdecimal/releases/mpdecimal-$pkgver.tar.gz")
sha256sums=('96d33abb4bb0070c7be0fed4246cd38416188325f820468214471938545b1ac8')

build() {
	cd "$pkgname-$pkgver"
	./configure --prefix=/usr --disable-static --docdir=/usr/share/doc/mpdecimal-$pkgver
	make
}

package() {
	cd "$pkgname-$pkgver"
	make DESTDIR="$pkgdir" install
}
