# Maintainer: BlankOS <builds@blankos.invalid>
# Based on LFS 13.1 §8.50

pkgname=libelf
pkgver=0.195
pkgrel=1
pkgdesc="ELF object file access library (from elfutils)"
arch=(x86_64)
url='https://sourceware.org/elfutils/'
license=('LGPL-3.0-or-later' 'GPL-2.0-or-later')
depends=('glibc' 'zlib' 'xz' 'bzip2' 'zstd')
source=("https://sourceware.org/ftp/elfutils/$pkgver/elfutils-$pkgver.tar.bz2")
sha256sums=('37629fdf7f1f3dc2818e138fca2b8094177d6c2d0f701d3bb650a561218dc026')

build() {
	cd "elfutils-$pkgver"
	./configure --prefix=/usr \
		--disable-debuginfod \
		--enable-libdebuginfod=dummy
	make -C lib
	make -C libelf
}

package() {
	cd "elfutils-$pkgver"
	make -C libelf DESTDIR="$pkgdir" install
	install -Dm644 config/libelf.pc "$pkgdir/usr/lib/pkgconfig/libelf.pc"
	rm -f "$pkgdir/usr/lib/libelf.a"
}
