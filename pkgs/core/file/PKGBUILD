# Maintainer: BlankOS <builds@blankos.invalid>
# Based on LFS 13.1 §8.11

pkgname=file
pkgver=5.48
pkgrel=2
pkgdesc="File type identification utility"
arch=(x86_64)
url='https://www.darwinsys.com/file/'
license=('BSD-2-Clause')
depends=('glibc' 'zlib' 'xz' 'bzip2' 'zstd')
source=("https://astron.com/pub/file/file-$pkgver.tar.gz")
sha256sums=('ed14656883b23a364b4057c05595d93252da9bc473d30106519519d0da141283')

build() {
	cd "$pkgname-$pkgver"
	./configure --prefix=/usr
	make
}

package() {
	cd "$pkgname-$pkgver"
	make DESTDIR="$pkgdir" install
}
