# Maintainer: BlankOS <builds@blankos.invalid>
# Based on LFS 13.1 §8.80

pkgname=procps-ng
pkgver=4.0.7
pkgrel=2
pkgdesc="Utilities for monitoring your system and its processes"
arch=(x86_64)
url='https://gitlab.com/procps-ng/procps'
license=('GPL-2.0-or-later' 'LGPL-2.0-or-later')
depends=('glibc' 'ncurses' 'systemd')
provides=('procps')
source=("https://sourceforge.net/projects/procps-ng/files/Production/procps-ng-$pkgver.tar.xz")
sha256sums=('9d2021f47a4501c667862c9942a92d1953694b21d11bcd1702e83eb594e3d67d')

build() {
	cd "procps-ng-$pkgver"
	./configure --prefix=/usr \
	    --docdir=/usr/share/doc/procps-ng-$pkgver \
	    --disable-static \
	    --disable-kill \
	    --enable-watch8bit \
	    --with-systemd
	make
}

package() {
	cd "procps-ng-$pkgver"
	make DESTDIR="$pkgdir" install
}
