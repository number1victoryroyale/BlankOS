# Maintainer: BlankOS <builds@blankos.invalid>
# Based on LFS 13.1 §8.64

pkgname=groff
pkgver=1.24.1
pkgrel=1
pkgdesc="GNU troff text-formatting system"
arch=(x86_64)
url='https://www.gnu.org/software/groff/groff.html'
license=('GPL-3.0-or-later')
depends=('glibc' 'gcc' 'perl')
source=("https://ftpmirror.gnu.org/groff/groff-$pkgver.tar.gz")
sha256sums=('74e2819795b6aff431aeac983d63a9c8968eeaba2a2eba7df8ba4c7b41e7cfd8')

build() {
	cd "$pkgname-$pkgver"
	PAGE=letter ./configure --prefix=/usr
	make -j1
}

package() {
	cd "$pkgname-$pkgver"
	make DESTDIR="$pkgdir" install
}
