# Maintainer: BlankOS <builds@blankos.invalid>
# Based on LFS 13.1 §8.60

pkgname=kmod
pkgver=34.2
pkgrel=1
pkgdesc="Linux kernel module management tools and library"
arch=(x86_64)
url='https://git.kernel.org/pub/scm/utils/kernel/kmod/kmod.git'
license=('LGPL-2.1-or-later' 'GPL-2.0-or-later')
depends=('glibc' 'zlib' 'xz' 'zstd' 'openssl')
makedepends=('meson' 'ninja')
options=('emptydirs')
source=("https://www.kernel.org/pub/linux/utils/kernel/kmod/kmod-$pkgver.tar.xz")
sha256sums=('5a5d5073070cc7e0c7a7a3c6ec2a0e1780850c8b47b3e3892226b93ffcb9cb54')

build() {
	cd "$pkgname-$pkgver"
	meson setup build --prefix=/usr --buildtype=release -D manpages=false
	ninja -C build
}

package() {
	cd "$pkgname-$pkgver"
	DESTDIR="$pkgdir" ninja -C build install
	install -dm755 "$pkgdir"/{etc,usr/lib}/{depmod,modprobe}.d
}
