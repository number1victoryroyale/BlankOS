# Maintainer: BlankOS <builds@blankos.invalid>
# Based on LFS 13.1 §8.78

pkgname=dbus
pkgver=1.16.2
pkgrel=1
pkgdesc="Freedesktop.org message bus system"
arch=(x86_64)
url='https://www.freedesktop.org/wiki/Software/dbus/'
license=('AFL-2.1' 'GPL-2.0-or-later')
depends=('glibc' 'expat' 'systemd')
makedepends=('meson' 'ninja')
provides=('dbus-units')
source=("https://dbus.freedesktop.org/releases/dbus/dbus-$pkgver.tar.xz")
sha256sums=('0ba2a1a4b16afe7bceb2c07e9ce99a8c2c3508e5dec290dbb643384bd6beb7e2')

build() {
	cd "$pkgname-$pkgver"
	meson setup build --prefix=/usr --buildtype=release --wrap-mode=nofallback
	ninja -C build
}

package() {
	cd "$pkgname-$pkgver"
	DESTDIR="$pkgdir" ninja -C build install
	install -d "$pkgdir/var/lib/dbus"
	ln -sfv /etc/machine-id "$pkgdir/var/lib/dbus/machine-id"
}
