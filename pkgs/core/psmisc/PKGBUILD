# Maintainer: BlankOS <builds@blankos.invalid>
# Based on LFS 13.1 §8.35

pkgname=psmisc
pkgver=23.7
pkgrel=2
pkgdesc="Miscellaneous procfs tools"
arch=(x86_64)
url='https://gitlab.com/psmisc/psmisc'
license=('GPL-2.0-or-later')
depends=('glibc' 'ncurses')
source=("https://sourceforge.net/projects/psmisc/files/psmisc/psmisc-$pkgver.tar.xz")
sha256sums=('58c55d9c1402474065adae669511c191de374b0871eec781239ab400b907c327')

build() {
	cd "$pkgname-$pkgver"
	./configure --prefix=/usr
	make
}

package() {
	cd "$pkgname-$pkgver"
	make DESTDIR="$pkgdir" install
}
