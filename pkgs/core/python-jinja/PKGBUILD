# Maintainer: BlankOS <builds@blankos.invalid>
# Based on LFS 13.1 §8.76

pkgname=python-jinja
pkgver=3.1.6
pkgrel=2
pkgdesc="A simple pythonic template language written in Python"
arch=(x86_64)
url='https://palletsprojects.com/p/jinja/'
license=('BSD-3-Clause')
depends=('python' 'python-markupsafe')
source=("https://pypi.org/packages/source/j/jinja2/jinja2-$pkgver.tar.gz")
sha256sums=('0137fb05990d35f1275a587e9aee6d56da821fc83491a0fb838183be43f66d6d')

build() {
	cd "jinja2-$pkgver"
	pip3 wheel -w dist --no-cache-dir --no-build-isolation --no-deps "$PWD"
}

package() {
	cd "jinja2-$pkgver"
	pip3 install --root="$pkgdir" --no-index --find-links dist \
		--no-deps --ignore-installed --no-cache-dir --no-warn-script-location Jinja2
}
