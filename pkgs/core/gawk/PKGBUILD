# Maintainer: BlankOS <builds@blankos.invalid>
# Based on LFS 13.1 §8.31

pkgname=gawk
pkgver=5.4.1
pkgrel=2
pkgdesc="GNU version of awk"
arch=(x86_64)
url='https://www.gnu.org/software/gawk/'
license=('GPL-3.0-or-later')
depends=('glibc' 'bash' 'mpfr' 'readline')
provides=('awk')
source=("https://ftpmirror.gnu.org/gawk/gawk-$pkgver.tar.xz")
sha256sums=('07f6f7342b7febe4313fc2c2542ad93d64fe20ad8717200109f105a826f5fd37')

prepare() {
	cd "$pkgname-$pkgver"
	sed -i 's/extras//' Makefile.in
}

build() {
	cd "$pkgname-$pkgver"
	./configure --prefix=/usr
	make
}

package() {
	cd "$pkgname-$pkgver"
	make DESTDIR="$pkgdir" install
	ln -sfv gawk.1 "$pkgdir/usr/share/man/man1/awk.1"
}
