# Maintainer: BlankOS <builds@blankos.invalid>
# Based on BLFS 13.1 (systemd)

pkgname=libidn2
pkgver=2.3.8
pkgrel=1
pkgdesc="Implementation of the IDNA2008, Punycode and TR46 specifications"
arch=(x86_64)
url='https://www.gnu.org/software/libidn/#libidn2'
license=('GPL-3.0-or-later' 'LGPL-3.0-or-later')
depends=('glibc' 'libunistring')
source=("https://ftp.gnu.org/gnu/libidn/libidn2-$pkgver.tar.gz")
sha256sums=('f557911bf6171621e1f72ff35f5b1825bb35b52ed45325dcdee931e5d3c0787a')

build() {
	cd "$pkgname-$pkgver"
	./configure --prefix=/usr --disable-static
	make
}

package() {
	cd "$pkgname-$pkgver"
	make DESTDIR="$pkgdir" install
}
