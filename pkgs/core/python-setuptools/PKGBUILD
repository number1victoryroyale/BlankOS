# Maintainer: BlankOS <builds@blankos.invalid>
# Based on LFS 13.1 §8.58

pkgname=python-setuptools
pkgver=84.0.0
pkgrel=1
pkgdesc="Easily download, build, install, upgrade, and uninstall Python packages"
arch=(x86_64)
url='https://github.com/pypa/setuptools'
license=('MIT')
depends=('python')
source=("https://pypi.org/packages/source/s/setuptools/setuptools-$pkgver.tar.gz")
sha256sums=('f4695c21257f0d9b537ec2692c941d02ee143b7cc1276941349a546573b2ef73')

build() {
	cd "setuptools-$pkgver"
	pip3 wheel -w dist --no-cache-dir --no-build-isolation --no-deps "$PWD"
}

package() {
	cd "setuptools-$pkgver"
	pip3 install --root="$pkgdir" --no-index --find-links dist \
		--no-deps --ignore-installed --no-cache-dir --no-warn-script-location setuptools
}
