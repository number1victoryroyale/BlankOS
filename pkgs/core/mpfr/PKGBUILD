# Maintainer: BlankOS <builds@blankos.invalid>
# Based on LFS 13.1 §8.24

pkgname=mpfr
pkgver=4.2.2
pkgrel=2
pkgdesc="Multiple-precision floating-point library"
arch=(x86_64)
url='https://www.mpfr.org/'
license=('LGPL-3.0-or-later')
depends=('gmp')
source=("https://ftpmirror.gnu.org/mpfr/mpfr-$pkgver.tar.xz")
sha256sums=('b67ba0383ef7e8a8563734e2e889ef5ec3c3b898a01d00fa0a6869ad81c6ce01')

build() {
	cd "$pkgname-$pkgver"
	./configure --prefix=/usr --disable-static --enable-thread-safe --docdir=/usr/share/doc/mpfr-$pkgver
	make
}

package() {
	cd "$pkgname-$pkgver"
	make DESTDIR="$pkgdir" install
}
