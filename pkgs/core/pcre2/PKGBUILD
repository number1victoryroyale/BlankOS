# Maintainer: BlankOS <builds@blankos.invalid>
# Based on LFS 13.1 §8.13

pkgname=pcre2
pkgver=10.47
pkgrel=1
pkgdesc="Perl Compatible Regular Expressions, version 2"
arch=(x86_64)
url='https://github.com/PCRE2Project/pcre2'
license=('BSD-3-Clause')
depends=('glibc' 'zlib' 'bzip2' 'readline')
source=("https://github.com/PCRE2Project/pcre2/releases/download/pcre2-$pkgver/pcre2-$pkgver.tar.bz2")
sha256sums=('47fe8c99461250d42f89e6e8fdaeba9da057855d06eb7fc08d9ca03fd08d7bc7')

build() {
	cd "$pkgname-$pkgver"
	./configure --prefix=/usr \
	      --docdir=/usr/share/doc/pcre2-$pkgver \
	      --enable-unicode \
	      --enable-jit \
	      --enable-pcre2-16 \
	      --enable-pcre2-32 \
	      --enable-pcre2grep-libz \
	      --enable-pcre2grep-libbz2 \
	      --enable-pcre2test-libreadline \
	      --disable-static
	make
}

package() {
	cd "$pkgname-$pkgver"
	make DESTDIR="$pkgdir" install
}
