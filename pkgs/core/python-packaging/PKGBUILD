# Maintainer: BlankOS <builds@blankos.invalid>
# Based on LFS 13.1 §8.56

pkgname=python-packaging
pkgver=26.3
pkgrel=2
pkgdesc="Core utilities for Python packages"
arch=(x86_64)
url='https://github.com/pypa/packaging'
license=('Apache-2.0' 'BSD-2-Clause')
depends=('python')
source=("https://pypi.org/packages/source/p/packaging/packaging-$pkgver.tar.gz")
sha256sums=('94edc256424af38762eb31306eed28beb9f0efc50a8837492c9d6fd6004aed79')

build() {
	cd "packaging-$pkgver"
	pip3 wheel -w dist --no-cache-dir --no-build-isolation --no-deps "$PWD"
}

package() {
	cd "packaging-$pkgver"
	pip3 install --root="$pkgdir" --no-index --find-links dist \
		--no-deps --ignore-installed --no-cache-dir --no-warn-script-location packaging
}
