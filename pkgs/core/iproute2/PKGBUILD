# Maintainer: BlankOS <builds@blankos.invalid>
# Based on LFS 13.1 §8.67

pkgname=iproute2
pkgver=7.1.0
pkgrel=2
pkgdesc="IP Routing Utilities"
arch=(x86_64)
url='https://wiki.linuxfoundation.org/networking/iproute2'
license=('GPL-2.0-or-later')
depends=('glibc' 'libelf' 'libcap')
source=("https://www.kernel.org/pub/linux/utils/net/iproute2/iproute2-$pkgver.tar.xz")
sha256sums=('fd9fa1b95809417157ca83dd72957e3261bdbce896353cb936f80af0b33a4b5c')

prepare() {
	cd "$pkgname-$pkgver"
	sed -i /ARPD/d Makefile
	rm -fv man/man8/arpd.8
}

build() {
	cd "$pkgname-$pkgver"
	make NETNS_RUN_DIR=/run/netns
}

package() {
	cd "$pkgname-$pkgver"
	make DESTDIR="$pkgdir" SBINDIR=/usr/sbin install
}
