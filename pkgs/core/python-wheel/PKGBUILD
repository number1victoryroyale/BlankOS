# Maintainer: BlankOS <builds@blankos.invalid>
# Based on LFS 13.1 §8.57

pkgname=python-wheel
pkgver=0.48.0
pkgrel=1
pkgdesc="A built-package format for Python"
arch=(x86_64)
url='https://github.com/pypa/wheel'
license=('MIT')
depends=('python' 'python-packaging')
source=("https://pypi.org/packages/source/w/wheel/wheel-$pkgver.tar.gz")
sha256sums=('94800765601e9171bf5d58d066e640662842bcedcbab982b2c90787a2c987322')

build() {
	cd "wheel-$pkgver"
	pip3 wheel -w dist --no-cache-dir --no-build-isolation --no-deps "$PWD"
}

package() {
	cd "wheel-$pkgver"
	pip3 install --root="$pkgdir" --no-index --find-links dist \
		--no-deps --ignore-installed --no-cache-dir --no-warn-script-location wheel
}
