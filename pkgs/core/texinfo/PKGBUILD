# Maintainer: BlankOS <builds@blankos.invalid>
# Based on LFS 13.1 §8.73

pkgname=texinfo
pkgver=7.3
pkgrel=2
pkgdesc="GNU documentation system for on-line information and printed output"
arch=(x86_64)
url='https://www.gnu.org/software/texinfo/'
license=('GPL-3.0-or-later')
depends=('glibc' 'ncurses' 'perl' 'gzip')
source=("https://ftpmirror.gnu.org/texinfo/texinfo-$pkgver.tar.xz")
sha256sums=('51f74eb0f51cfa9873b85264dfdd5d46e8957ec95b88f0fb762f63d9e164c72e')

build() {
	cd "$pkgname-$pkgver"
	./configure --prefix=/usr
	make
}

package() {
	cd "$pkgname-$pkgver"
	make DESTDIR="$pkgdir" install
	make DESTDIR="$pkgdir" TEXMF=/usr/share/texmf install-tex
}
