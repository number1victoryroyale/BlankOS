# Maintainer: BlankOS <builds@blankos.invalid>
# Based on LFS 13.1 §8.6

pkgname=zlib
pkgver=1.3.2
pkgrel=2
pkgdesc="Compression library implementing the deflate compression method"
arch=(x86_64)
url='https://zlib.net'
license=('Zlib')
depends=('glibc')
source=("https://zlib.net/fossils/zlib-$pkgver.tar.gz")
sha256sums=('bb329a0a2cd0274d05519d61c667c062e06990d72e125ee2dfa8de64f0119d16')

build() {
	cd "$pkgname-$pkgver"
	./configure --prefix=/usr
	make
}

package() {
	cd "$pkgname-$pkgver"
	make DESTDIR="$pkgdir" install
}
