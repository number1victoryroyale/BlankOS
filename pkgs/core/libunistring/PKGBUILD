# Maintainer: BlankOS <builds@blankos.invalid>
# Based on BLFS 13.1 (systemd)

pkgname=libunistring
pkgver=1.4.2
pkgrel=1
pkgdesc="Library for manipulating Unicode strings"
arch=(x86_64)
url='https://www.gnu.org/software/libunistring/'
license=('LGPL-3.0-or-later OR GPL-2.0-or-later')
depends=('glibc')
source=("https://ftp.gnu.org/gnu/libunistring/libunistring-$pkgver.tar.xz")
sha256sums=('5b46e74377ed7409c5b75e7a96f95377b095623b689d8522620927964a41499c')

build() {
	cd "$pkgname-$pkgver"
	./configure --prefix=/usr --disable-static
	make
}

package() {
	cd "$pkgname-$pkgver"
	make DESTDIR="$pkgdir" install
}
