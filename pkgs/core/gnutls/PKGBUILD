# Maintainer: BlankOS <builds@blankos.invalid>
# Based on BLFS 13.1 (systemd)

pkgname=gnutls
pkgver=3.8.13
pkgrel=1
pkgdesc="A library which provides a secure layer over a reliable transport layer"
arch=(x86_64)
url='https://www.gnutls.org/'
license=('GPL-3.0-or-later' 'LGPL-2.1-or-later')
depends=('glibc' 'gcc-libs' 'nettle' 'gmp' 'libtasn1' 'p11-kit' 'libunistring' 'libidn2' 'zlib' 'zstd' 'ca-certificates')
source=("https://www.gnupg.org/ftp/gcrypt/gnutls/v3.8/gnutls-$pkgver.tar.xz")
sha256sums=('ffed8ec1bf09c2426d4f14aae377de4753b53e537d685e604e99a8b16ca9c97e')

build() {
	cd "$pkgname-$pkgver"
	./configure --prefix=/usr --disable-static --disable-doc --disable-manpages \
		--with-default-trust-store-pkcs11="pkcs11:"
	make
}

package() {
	cd "$pkgname-$pkgver"
	make DESTDIR="$pkgdir" install
}
