# BlankOS bash defaults (shipped as /etc/bash.bashrc and ~/.bashrc).
[[ $- != *i* ]] && return

HISTCONTROL=ignoreboth
HISTSIZE=5000
shopt -s histappend checkwinsize

alias ls='ls --color=auto'
alias ll='ls -lh --color=auto'
alias grep='grep --color=auto'

# Violet BlankOS prompt: user@host dir $
# On the Linux console colour 35 *is* the BlankOS violet (see the console
# palette); terminal emulators get the exact 24-bit colours.
if [[ $TERM == linux ]]; then
	_accent='\[\e[35m\]' _light='\[\e[95m\]'
else
	_accent='\[\e[38;2;139;92;246m\]' _light='\[\e[38;2;167;139;250m\]'
fi
if [[ $EUID -eq 0 ]]; then
	PS1='\[\e[1;31m\]\u\[\e[0m\]@'"$_accent"'\h\[\e[0m\] \[\e[1m\]\w\[\e[0m\] # '
else
	PS1="$_light"'\u\[\e[0m\]@'"$_accent"'\h\[\e[0m\] \[\e[1m\]\w\[\e[0m\] $ '
fi
unset _accent _light
