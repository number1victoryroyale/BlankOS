# Maintainer: BlankOS <builds@blankos.invalid>

pkgname=pacman
pkgver=7.1.0
pkgrel=2
pkgdesc="A library-based package manager with dependency support"
arch=(x86_64)
url='https://pacman.archlinux.page/'
license=('GPL-2.0-or-later')
depends=('bash' 'glibc' 'libarchive' 'curl' 'openssl' 'gettext' 'coreutils' 'gawk' 'grep' 'file' 'findutils' 'sed' 'tar' 'xz' 'zstd' 'bzip2' 'gzip')
makedepends=('meson' 'ninja')
backup=('etc/pacman.conf' 'etc/makepkg.conf' 'etc/pacman.d/mirrorlist')
source=("https://gitlab.archlinux.org/pacman/pacman/-/releases/v$pkgver/downloads/pacman-$pkgver.tar.xz"
        "pacman.conf"
        "makepkg.conf"
        "mirrorlist")
sha256sums=('530e50d7edbb2a22581c6d6707d2113240276c1bec4ee39a99488e1243c32171'
            '49a79474aab218e65d96b21bb3779b6d6a2966e82b90db183bfa10252895e8e6'
            '60c8e4f989ffc9d47fc66f36186050ad2bf9e886452fc558dbb425690e4c63c3'
            'fe29da89ff54253c117802a4a3ffcf738853e632670dba82ffa4c1ac6797819c')

build() {
	cd "$pkgname-$pkgver"
	meson setup build --prefix=/usr --sysconfdir=/etc --localstatedir=/var \
		--buildtype=release \
		-Dcrypto=openssl -Dgpgme=disabled -Dcurl=enabled \
		-Ddoc=disabled \
		-Dscriptlet-shell=/usr/bin/bash \
		-Dldconfig=/usr/sbin/ldconfig \
		-Dpkg-ext=.pkg.tar.zst -Dsrc-ext=.src.tar.gz
	ninja -C build
}

package() {
	cd "$pkgname-$pkgver"
	DESTDIR="$pkgdir" ninja -C build install
	install -m644 "$srcdir/pacman.conf" "$pkgdir/etc/pacman.conf"
	install -m644 "$srcdir/makepkg.conf" "$pkgdir/etc/makepkg.conf"
	install -Dm644 "$srcdir/mirrorlist" "$pkgdir/etc/pacman.d/mirrorlist"
}
