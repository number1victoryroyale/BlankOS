# Maintainer: BlankOS <builds@blankos.invalid>
# Based on LFS 13.1 §8.59

pkgname=meson
pkgver=1.12.0
pkgrel=1
pkgdesc="High productivity build system"
arch=(any)
url='https://mesonbuild.com/'
license=('Apache-2.0')
depends=('python' 'python-setuptools' 'ninja')
source=("https://github.com/mesonbuild/meson/releases/download/$pkgver/meson-$pkgver.tar.gz")
sha256sums=('88afe0c20e52030218924ac37d0c81c59b4b5f3ae3752c8c6d7470c7d365886c')

build() {
	cd "$pkgname-$pkgver"
	pip3 wheel -w dist --no-cache-dir --no-build-isolation --no-deps "$PWD"
}

package() {
	cd "$pkgname-$pkgver"
	pip3 install --root="$pkgdir" --no-index --find-links dist \
		--no-deps --ignore-installed --no-cache-dir --no-warn-script-location meson
	install -Dm644 data/shell-completions/bash/meson "$pkgdir/usr/share/bash-completion/completions/meson"
	install -Dm644 data/shell-completions/zsh/_meson "$pkgdir/usr/share/zsh/site-functions/_meson"
}
