# Maintainer: BlankOS <builds@blankos.invalid>
# Based on BLFS 13.1 (systemd)

pkgname=libsm
pkgver=1.2.6
pkgrel=1
pkgdesc="X11 Session Management library"
arch=(x86_64)
url='https://xorg.freedesktop.org/'
license=('MIT')
depends=('libice' 'util-linux')
makedepends=('xorgproto' 'xorg-util-macros' 'xtrans')
source=("https://www.x.org/pub/individual/lib/libSM-$pkgver.tar.xz")
sha256sums=('be7c0abdb15cbfd29ac62573c1c82e877f9d4047ad15321e7ea97d1e43d835be')

build() {
	cd "libSM-$pkgver"
	./configure --prefix=/usr --sysconfdir=/etc --localstatedir=/var --disable-static
	make
}

package() {
	cd "libSM-$pkgver"
	make DESTDIR="$pkgdir" install
}
