# Maintainer: BlankOS <builds@blankos.invalid>
# Based on BLFS 13.1 (systemd) and Arch Linux's baloo

pkgname=baloo
pkgver=6.29.0
pkgrel=1
pkgdesc="A framework for searching and managing metadata"
arch=(x86_64)
url='https://develop.kde.org/products/frameworks/'
license=('LGPL-2.0-only' 'LGPL-3.0-only')
depends=('glibc' 'kconfig' 'kcoreaddons' 'kcrash' 'kdbusaddons' 'kfilemetadata' 'ki18n' 'kidletime' 'kio' 'gcc-libs' 'lmdb' 'qt6-base' 'solid')
makedepends=('cmake' 'ninja' 'extra-cmake-modules' 'qt6-tools' 'kdoctools')
source=("https://download.kde.org/stable/frameworks/${pkgver%.*}/baloo-$pkgver.tar.xz")
sha256sums=('be0f85dc22ed8a6ffe06b2b260b739da15bbeed95064a4f663632701e3170ed0')

build() {
	cmake -S "baloo-$pkgver" -B build -G Ninja -D CMAKE_INSTALL_PREFIX=/usr \
		-D CMAKE_BUILD_TYPE=Release -D CMAKE_INSTALL_LIBDIR=lib -D CMAKE_INSTALL_LIBEXECDIR=lib \
		-D CMAKE_SKIP_INSTALL_RPATH=ON -D BUILD_TESTING=OFF -W no-dev \
		-D BUILD_QCH=OFF -D BUILD_PYTHON_BINDINGS=OFF
	ninja -C build
}

package() {
	DESTDIR="$pkgdir" ninja -C build install
}
