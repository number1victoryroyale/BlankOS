# Maintainer: BlankOS <builds@blankos.invalid>
# Based on BLFS 13.1 (systemd): hardware sensors for Plasma's System
# Monitor (CPU/GPU temperatures, fans)

pkgname=lm_sensors
pkgver=3.6.2
_tag=3-6-2
pkgrel=1
pkgdesc="Collection of user space tools for general SMBus access and hardware monitoring"
arch=(x86_64)
url='https://github.com/hramrach/lm-sensors'
license=('GPL-2.0-or-later' 'LGPL-2.1-or-later')
depends=('perl' 'glibc')
makedepends=('flex' 'bison')
source=("https://github.com/hramrach/lm-sensors/archive/V$_tag/lm-sensors-$_tag.tar.gz")
sha256sums=('c6a0587e565778a40d88891928bf8943f27d353f382d5b745a997d635978a8f0')

build() {
	cd "lm-sensors-$_tag"
	make PREFIX=/usr BUILD_STATIC_LIB=0 MANDIR=/usr/share/man
}

package() {
	cd "lm-sensors-$_tag"
	make PREFIX=/usr BUILD_STATIC_LIB=0 MANDIR=/usr/share/man DESTDIR="$pkgdir" install
}
