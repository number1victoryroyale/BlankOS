# Maintainer: BlankOS <builds@blankos.invalid>
# Based on BLFS 13.1 (systemd) and Arch Linux's ktexteditor

pkgname=ktexteditor
pkgver=6.29.0
pkgrel=1
pkgdesc="Advanced embeddable text editor"
arch=(x86_64)
url='https://develop.kde.org/products/frameworks/'
license=('LGPL-2.0-only' 'LGPL-3.0-only')
depends=('glibc' 'karchive' 'kauth' 'kcodecs' 'kcolorscheme' 'kcompletion' 'kconfig' 'kconfigwidgets' 'kcoreaddons' 'kguiaddons' 'ki18n' 'kio' 'kitemviews' 'kparts' 'kwidgetsaddons' 'kxmlgui' 'gcc-libs' 'qt6-base' 'qt6-declarative' 'sonnet' 'syntax-highlighting')
makedepends=('cmake' 'ninja' 'extra-cmake-modules' 'qt6-tools')
source=("https://download.kde.org/stable/frameworks/${pkgver%.*}/ktexteditor-$pkgver.tar.xz")
sha256sums=('ab28187332c2e4af1706999bc1fb51256f32dc2ebd28bc21081062b8ff1e4ce7')

build() {
	cmake -S "ktexteditor-$pkgver" -B build -G Ninja -D CMAKE_INSTALL_PREFIX=/usr \
		-D CMAKE_BUILD_TYPE=Release -D CMAKE_INSTALL_LIBDIR=lib -D CMAKE_INSTALL_LIBEXECDIR=lib \
		-D CMAKE_SKIP_INSTALL_RPATH=ON -D BUILD_TESTING=OFF -W no-dev \
		-D BUILD_QCH=OFF -D BUILD_PYTHON_BINDINGS=OFF
	ninja -C build
}

package() {
	DESTDIR="$pkgdir" ninja -C build install
}
