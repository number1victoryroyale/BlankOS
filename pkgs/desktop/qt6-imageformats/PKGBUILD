# Maintainer: BlankOS <builds@blankos.invalid>
# Based on BLFS 13.1 (systemd) and Arch Linux's qt6-imageformats

pkgname=qt6-imageformats
_qtver=6.11.2
pkgver=$_qtver
pkgrel=1
pkgdesc="Plugins for additional image formats: TIFF, MNG, TGA, WBMP"
arch=(x86_64)
url='https://www.qt.io'
license=('GPL-3.0-only' 'LGPL-3.0-only' 'LicenseRef-Qt-Commercial' 'Qt-GPL-exception-1.0')
depends=('glibc' 'gcc-libs' 'libtiff' 'libwebp' 'qt6-base')
makedepends=('cmake' 'ninja')
source=("https://download.qt.io/official_releases/qt/${pkgver%.*}/$pkgver/submodules/qtimageformats-everywhere-src-$pkgver.tar.xz")
sha256sums=('cecd8900f34b6550076309bc94f62f828008b633a4239e0a08c86788f41001f8')

build() {
	cmake -S "qtimageformats-everywhere-src-$pkgver" -B build -G Ninja -D CMAKE_MESSAGE_LOG_LEVEL=STATUS \
		-D CMAKE_BUILD_TYPE=Release -D QT_BUILD_TESTS=OFF -D QT_BUILD_EXAMPLES=OFF \
		-D FEATURE_jasper=OFF -D FEATURE_mng=OFF
	cmake --build build
}

package() {
	DESTDIR="$pkgdir" cmake --install build
	install -Dm644 "qtimageformats-everywhere-src-$pkgver/LICENSES"/* -t "$pkgdir/usr/share/licenses/$pkgname"

	# Qt also writes these links relative to the prefix (/usr/usr/bin)
	rm -rf "$pkgdir/usr/usr"
	# user-facing tools (qmake6, qdbus6, ...) in /usr/bin
	if [[ -f $srcdir/build/user_facing_tool_links.txt ]]; then
		cd "$pkgdir"
		mkdir -p usr/bin
		while read -r _line; do
			ln -s $_line
		done < "$srcdir/build/user_facing_tool_links.txt"
	fi
}
