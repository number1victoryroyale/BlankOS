# Maintainer: BlankOS <builds@blankos.invalid>
# Based on BLFS 13.1 (systemd) and Arch Linux's qcoro

pkgname=qcoro
pkgver=0.13.0
pkgrel=1
pkgdesc="C++ Coroutines for Qt"
arch=(x86_64)
url='https://github.com/danvratil/qcoro'
license=('MIT')
depends=('glibc' 'gcc-libs' 'qt6-base' 'qt6-declarative')
makedepends=('cmake' 'ninja' 'extra-cmake-modules' 'qt6-tools')
source=("https://github.com/danvratil/qcoro/archive/v$pkgver/qcoro-$pkgver.tar.gz")
sha256sums=('4bff7513c5c8e301b66308df05795043b1792ed16381a484e5c990171b8ff19e')

build() {
	cmake -S "qcoro-$pkgver" -B build -G Ninja -D CMAKE_INSTALL_PREFIX=/usr \
		-D CMAKE_BUILD_TYPE=Release -D CMAKE_INSTALL_LIBDIR=lib -D CMAKE_INSTALL_LIBEXECDIR=lib \
		-D CMAKE_SKIP_INSTALL_RPATH=ON -D BUILD_TESTING=OFF -W no-dev \
		-D QCORO_BUILD_EXAMPLES=OFF -D BUILD_SHARED_LIBS=ON -D USE_QT_VERSION=6 -D QCORO_WITH_QTWEBSOCKETS=OFF
	ninja -C build
}

package() {
	DESTDIR="$pkgdir" ninja -C build install
}
