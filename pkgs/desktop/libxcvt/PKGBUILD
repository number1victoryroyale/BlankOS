# Maintainer: BlankOS <builds@blankos.invalid>
# Based on BLFS 13.1 (systemd)

pkgname=libxcvt
pkgver=0.1.3
pkgrel=1
pkgdesc="Calculates VESA CVT standard timings"
arch=(x86_64)
url='https://gitlab.freedesktop.org/xorg/lib/libxcvt'
license=('MIT')
depends=('glibc')
source=("https://www.x.org/pub/individual/lib/libxcvt-$pkgver.tar.xz")
sha256sums=('a929998a8767de7dfa36d6da4751cdbeef34ed630714f2f4a767b351f2442e01')

build() {
	meson setup build "libxcvt-$pkgver" --prefix=/usr --buildtype=release
	ninja -C build
}

package() {
	DESTDIR="$pkgdir" ninja -C build install
}
