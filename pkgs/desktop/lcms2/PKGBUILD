# Maintainer: BlankOS <builds@blankos.invalid>
# Based on BLFS 13.1 (systemd)

pkgname=lcms2
pkgver=2.19.1
pkgrel=1
pkgdesc="Small-footprint color management engine"
arch=(x86_64)
url='https://www.littlecms.com/'
license=('MIT')
depends=('libtiff')
source=("https://github.com/mm2/Little-CMS/releases/download/lcms2.19.1/lcms2-$pkgver.tar.gz")
sha256sums=('bfc54f7bab59fbc921012014a8032e4cba4abd46db47d46b76416a8c0b2815c8')

build() {
	cd "lcms2-$pkgver"
	./configure --prefix=/usr --sysconfdir=/etc --localstatedir=/var --disable-static
	make
}

package() {
	cd "lcms2-$pkgver"
	make DESTDIR="$pkgdir" install
}
