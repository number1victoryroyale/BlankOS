# Maintainer: BlankOS <builds@blankos.invalid>
# Based on BLFS 13.1 (systemd) and Arch Linux's discover

pkgname=discover
pkgver=6.7.4
pkgrel=2
pkgdesc="KDE and Plasma resources management GUI"
arch=(x86_64)
url='https://apps.kde.org/discover/'
license=('LGPL-2.0-or-later')
depends=('appstream-qt' 'attica' 'glib2' 'glibc' 'kcmutils' 'kconfig' 'kcoreaddons' 'kcrash' 'kdbusaddons' 'ki18n' 'kiconthemes' 'kidletime' 'kio' 'kirigami' 'kirigami-addons' 'kjobwidgets' 'knewstuff' 'knotifications' 'kservice' 'kstatusnotifieritem' 'kuserfeedback' 'kwidgetsaddons' 'kwindowsystem' 'gcc-libs' 'purpose' 'qcoro' 'qt6-base' 'qt6-declarative' 'flatpak')
makedepends=('cmake' 'ninja' 'extra-cmake-modules' 'qt6-tools')
source=("https://download.kde.org/stable/plasma/$pkgver/discover-$pkgver.tar.xz")
sha256sums=('f8b809c9aaa25c1d636b0bdf144d87a3ee659d5d80f26961d3116a627fef859d')

build() {
	cmake -S "discover-$pkgver" -B build -G Ninja -D CMAKE_INSTALL_PREFIX=/usr \
		-D CMAKE_BUILD_TYPE=Release -D CMAKE_INSTALL_LIBDIR=lib -D CMAKE_INSTALL_LIBEXECDIR=lib \
		-D BUILD_TESTING=OFF -W no-dev \
		-D BUILD_QT5=OFF -D BUILD_FlatpakBackend=ON -D BUILD_PackageKitBackend=OFF -D BUILD_FwupdBackend=OFF \
		-D BUILD_SnapBackend=OFF -D BUILD_RpmOstreeBackend=OFF -D BUILD_SteamOSBackend=OFF
	ninja -C build
}

package() {
	DESTDIR="$pkgdir" ninja -C build install
}
