# Maintainer: BlankOS <builds@blankos.invalid>
# Based on BLFS 13.1 (systemd) and Arch Linux's kactivitymanagerd

pkgname=kactivitymanagerd
pkgver=6.7.4
pkgrel=1
pkgdesc="System service to manage user activities and track the usage patterns"
arch=(x86_64)
url='https://kde.org/plasma-desktop/'
license=('LGPL-2.0-or-later')
depends=('glibc' 'kconfig' 'kcoreaddons' 'kcrash' 'kglobalaccel' 'ki18n' 'kio' 'kservice' 'kxmlgui' 'gcc-libs' 'qt6-base')
makedepends=('cmake' 'ninja' 'extra-cmake-modules' 'qt6-tools' 'boost')
source=("https://download.kde.org/stable/plasma/$pkgver/kactivitymanagerd-$pkgver.tar.xz")
sha256sums=('b2e9c2537ddcc243774d41355428335167c2bb8e9fc48143c4e467528536c87f')

build() {
	cmake -S "kactivitymanagerd-$pkgver" -B build -G Ninja -D CMAKE_INSTALL_PREFIX=/usr \
		-D CMAKE_BUILD_TYPE=Release -D CMAKE_INSTALL_LIBDIR=lib -D CMAKE_INSTALL_LIBEXECDIR=lib \
		-D CMAKE_SKIP_INSTALL_RPATH=ON -D BUILD_TESTING=OFF -W no-dev \
		-D BUILD_QT5=OFF
	ninja -C build
}

package() {
	DESTDIR="$pkgdir" ninja -C build install
}
