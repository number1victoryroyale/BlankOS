# Maintainer: BlankOS <builds@blankos.invalid>
#
# The BlankOS look: a Plasma look-and-feel (BlankOS colors on Breeze,
# breeze-dark icons and Plasma style), the wallpaper (drawn at build time
# by mkwallpaper.py), the SDDM background and a Konsole profile; and the
# graphical GRUB theme (fonts made with grub-mkfont, built here from the
# GRUB sources because the core grub package has no FreeType).

pkgbase=blankos-branding
pkgname=('blankos-branding' 'blankos-grub-theme')
pkgver=1.0
pkgrel=1
_grubver=2.14
arch=(any)
url='https://github.com/number1victoryroyale/BlankOS'
license=('GPL-3.0-or-later' 'CC-BY-SA-4.0')
makedepends=('python' 'freetype2' 'noto-fonts')
source=("BlankOS.colors" "lnf-metadata.json" "lnf-defaults" "wallpaper-metadata.json" "mkwallpaper.py"
        "sddm-theme.conf.user" "BlankOS.colorscheme" "BlankOS.profile" "konsolerc"
        "mkpng.py" "grub-theme.txt"
        "https://ftpmirror.gnu.org/grub/grub-$_grubver.tar.xz")
