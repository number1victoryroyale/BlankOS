# Maintainer: BlankOS <builds@blankos.invalid>
# Based on BLFS 13.1 (systemd) and Arch Linux's modemmanager-qt

pkgname=modemmanager-qt
pkgver=6.29.0
pkgrel=1
pkgdesc="Qt wrapper for ModemManager DBus API"
arch=(x86_64)
url='https://develop.kde.org/products/frameworks/'
license=('LGPL-2.0-only' 'LGPL-3.0-only')
depends=('modemmanager' 'qt6-base' 'gcc-libs')
makedepends=('cmake' 'ninja' 'extra-cmake-modules' 'qt6-tools')
source=("https://download.kde.org/stable/frameworks/${pkgver%.*}/modemmanager-qt-$pkgver.tar.xz")
sha256sums=('4af60497e5331b41a3b34e194c1fb4293cd5eae7b50b5ecf5959a9718b223b47')

build() {
	cmake -S "modemmanager-qt-$pkgver" -B build -G Ninja -D CMAKE_INSTALL_PREFIX=/usr \
		-D CMAKE_BUILD_TYPE=Release -D CMAKE_INSTALL_LIBDIR=lib -D CMAKE_INSTALL_LIBEXECDIR=lib \
		-D CMAKE_SKIP_INSTALL_RPATH=ON -D BUILD_TESTING=OFF -W no-dev \
		-D BUILD_QCH=OFF
	ninja -C build
}

package() {
	DESTDIR="$pkgdir" ninja -C build install
}
