# Maintainer: BlankOS <builds@blankos.invalid>
# Based on BLFS 13.1 (systemd)

pkgname=xcb-util-keysyms
pkgver=0.4.1
pkgrel=1
pkgdesc="Utility libraries for XC Binding - Standard X constants and conversion to/from keycodes"
arch=(x86_64)
url='https://xcb.freedesktop.org/'
license=('MIT')
depends=('libxcb')
source=("https://xorg.freedesktop.org/archive/individual/lib/xcb-util-keysyms-$pkgver.tar.xz")
sha256sums=('7c260a5294412aed429df1da2f8afd3bd07b7cba3fec772fba15a613a6d5c638')

build() {
	cd "xcb-util-keysyms-$pkgver"
	./configure --prefix=/usr --sysconfdir=/etc --localstatedir=/var --disable-static
	make
}

package() {
	cd "xcb-util-keysyms-$pkgver"
	make DESTDIR="$pkgdir" install
}
