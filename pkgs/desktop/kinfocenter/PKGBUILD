# Maintainer: BlankOS <builds@blankos.invalid>
# Based on BLFS 13.1 (systemd) and Arch Linux's kinfocenter

pkgname=kinfocenter
pkgver=6.7.4
pkgrel=1
pkgdesc="A utility that provides information about a computer system"
arch=(x86_64)
url='https://kde.org/plasma-desktop/'
license=('LGPL-2.0-or-later')
depends=('glibc' 'iproute2' 'kauth' 'kcmutils' 'kconfig' 'kcoreaddons' 'kdeclarative' 'ki18n' 'kio' 'kirigami' 'kservice' 'libdisplay-info' 'libdrm' 'libglvnd' 'libpulse' 'gcc-libs' 'libusb' 'qt6-base' 'qt6-declarative' 'sh' 'solid' 'systemd' 'systemsettings' 'vulkan-tools')
makedepends=('cmake' 'ninja' 'extra-cmake-modules' 'qt6-tools' 'kdoctools' 'vulkan-headers')
source=("https://download.kde.org/stable/plasma/$pkgver/kinfocenter-$pkgver.tar.xz")
sha256sums=('b82f7fae6941ab9e0327a0579ada51b12ad3c5a4fa5fcd8272c70aea09a1ff23')

build() {
	cmake -S "kinfocenter-$pkgver" -B build -G Ninja -D CMAKE_INSTALL_PREFIX=/usr \
		-D CMAKE_BUILD_TYPE=Release -D CMAKE_INSTALL_LIBDIR=lib -D CMAKE_INSTALL_LIBEXECDIR=lib \
		-D CMAKE_SKIP_INSTALL_RPATH=ON -D BUILD_TESTING=OFF -W no-dev \
		-D BUILD_QT5=OFF
	ninja -C build
}

package() {
	DESTDIR="$pkgdir" ninja -C build install
}
