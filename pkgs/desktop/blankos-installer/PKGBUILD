build() {
	python3 mklogo.py 256 logo.png
	python3 mklogo.py 64 icon64.png
}

package() {
	local c=$pkgdir/etc/calamares
	install -Dm644 settings.conf "$c/settings.conf"
	local m
	for m in welcome unpackfs partition mount users displaymanager grubcfg bootloader fstab \
	         shellprocess-cleanup shellprocess-initramfs shellprocess-palette; do
		install -Dm644 "$m.conf" "$c/modules/$m.conf"
	done
	install -Dm644 branding.desc show.qml logo.png -t "$c/branding/blankos"
	ln -s /usr/share/wallpapers/BlankOS/contents/images/1920x1080.png "$c/branding/blankos/welcome.png"

	install -Dm644 blankos-install.desktop "$pkgdir/usr/share/applications/blankos-install.desktop"
	install -Dm644 logo.png "$pkgdir/usr/share/icons/hicolor/256x256/apps/blankos-installer.png"
	install -Dm644 icon64.png "$pkgdir/usr/share/icons/hicolor/64x64/apps/blankos-installer.png"
	install -Dm644 org.blankos.installer.policy "$pkgdir/usr/share/polkit-1/actions/org.blankos.installer.policy"
}
