# Maintainer: BlankOS <builds@blankos.invalid>
# The BlankOS installer: Calamares settings (copy the live system, set up
# users, GRUB with the BlankOS theme, the initramfs, and remove the live
# session's extras), BlankOS branding and slideshow, and the "Install
# BlankOS" launcher. The installer removes itself from the new system.

pkgname=blankos-installer
pkgver=1.0
pkgrel=1
pkgdesc="BlankOS installer (Calamares settings, branding and launcher)"
arch=(any)
url='https://github.com/number1victoryroyale/BlankOS'
license=('GPL-3.0-or-later')
depends=('calamares' 'blankos-branding' 'blankos-grub-theme' 'blankos-initramfs' 'polkit')
makedepends=('python')
source=("settings.conf" "branding.desc" "show.qml" "mklogo.py"
        "blankos-install.desktop" "org.blankos.installer.policy"
        "welcome.conf" "unpackfs.conf"
        "partition.conf" "mount.conf"
        "users.conf" "displaymanager.conf"
        "grubcfg.conf" "bootloader.conf"
        "fstab.conf"
        "shellprocess-cleanup.conf"
        "shellprocess-initramfs.conf"
        "shellprocess-palette.conf")
sha256sums=('4c43d5bb3bd3774a729a63974d9e59bd872043e71a92e9eeb844c896cc5d6bc1'
