# Maintainer: BlankOS <builds@blankos.invalid>
# Based on BLFS 13.1 (systemd) and Arch Linux's kpipewire

pkgname=kpipewire
pkgver=6.7.4
pkgrel=1
pkgdesc="Components relating to pipewire use in Plasma"
arch=(x86_64)
url='https://kde.org/plasma-desktop/'
license=('LGPL-2.0-or-later')
depends=('libva' 'ffmpeg' 'glibc' 'kcoreaddons' 'ki18n' 'libdrm' 'libepoxy' 'pipewire' 'gcc-libs' 'mesa' 'qt6-base' 'qt6-declarative')
makedepends=('cmake' 'ninja' 'extra-cmake-modules' 'qt6-tools')
source=("https://download.kde.org/stable/plasma/$pkgver/kpipewire-$pkgver.tar.xz")
sha256sums=('2020a6a94bb7726ec68004c7946ad7f6ed450dcee8f4e8b710c3680755afb1ab')

build() {
	cmake -S "kpipewire-$pkgver" -B build -G Ninja -D CMAKE_INSTALL_PREFIX=/usr \
		-D CMAKE_BUILD_TYPE=Release -D CMAKE_INSTALL_LIBDIR=lib -D CMAKE_INSTALL_LIBEXECDIR=lib \
		-D CMAKE_SKIP_INSTALL_RPATH=ON -D BUILD_TESTING=OFF -W no-dev \
		-D BUILD_QT5=OFF
	ninja -C build
}

package() {
	DESTDIR="$pkgdir" ninja -C build install
}
