# Maintainer: BlankOS <builds@blankos.invalid>
# Based on BLFS 13.1 (systemd) and Arch Linux's qt6-speech
# Text to speech for KTextEditor/KTextWidgets (no speech engine yet).

pkgname=qt6-speech
_qtver=6.11.2
pkgver=$_qtver
pkgrel=1
pkgdesc="Qt module to make text to speech and speech recognition easy"
arch=(x86_64)
url='https://www.qt.io'
license=('GPL-3.0-only' 'LGPL-3.0-only' 'LicenseRef-Qt-Commercial')
depends=('glibc' 'gcc-libs' 'qt6-base' 'qt6-multimedia')
makedepends=('cmake' 'ninja' 'qt6-declarative')
source=("https://download.qt.io/official_releases/qt/${pkgver%.*}/$pkgver/submodules/qtspeech-everywhere-src-$pkgver.tar.xz")
sha256sums=('9c1d05dc9d710049f20a67680fc6b4293c9b584a90f04f4cf6cc36e758c5cb98')

build() {
	cmake -S "qtspeech-everywhere-src-$pkgver" -B build -G Ninja -D CMAKE_MESSAGE_LOG_LEVEL=STATUS \
		-D CMAKE_BUILD_TYPE=Release -D QT_BUILD_TESTS=OFF -D QT_BUILD_EXAMPLES=OFF
	cmake --build build
}

package() {
	DESTDIR="$pkgdir" cmake --install build
	install -Dm644 "qtspeech-everywhere-src-$pkgver/LICENSES"/* -t "$pkgdir/usr/share/licenses/$pkgname"

	# Qt also writes these links relative to the prefix (/usr/usr/bin)
	rm -rf "$pkgdir/usr/usr"
	# user-facing tools (qmake6, qdbus6, ...) in /usr/bin
	if [[ -f $srcdir/build/user_facing_tool_links.txt ]]; then
		cd "$pkgdir"
		mkdir -p usr/bin
		while read -r _line; do
			[[ -n $_line ]] || continue
			ln -s $_line
		done < "$srcdir/build/user_facing_tool_links.txt"
	fi
}
