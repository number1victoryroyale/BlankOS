# Maintainer: BlankOS <builds@blankos.invalid>
# Based on BLFS 13.1 (systemd) and Arch Linux's kstatusnotifieritem

pkgname=kstatusnotifieritem
pkgver=6.29.0
pkgrel=1
pkgdesc="Implementation of Status Notifier Items"
arch=(x86_64)
url='https://develop.kde.org/products/frameworks/'
license=('LGPL-2.0-or-later')
depends=('glibc' 'kwindowsystem' 'gcc-libs' 'qt6-base')
makedepends=('cmake' 'ninja' 'extra-cmake-modules' 'qt6-tools' 'python-setuptools')
source=("https://download.kde.org/stable/frameworks/${pkgver%.*}/kstatusnotifieritem-$pkgver.tar.xz")
sha256sums=('b2c9375edc219425b2ffc90b443e686fc48699a0ee0408b6a4e55a5f345dde2e')

build() {
	cmake -S "kstatusnotifieritem-$pkgver" -B build -G Ninja -D CMAKE_INSTALL_PREFIX=/usr \
		-D CMAKE_BUILD_TYPE=Release -D CMAKE_INSTALL_LIBDIR=lib -D CMAKE_INSTALL_LIBEXECDIR=lib \
		-D CMAKE_SKIP_INSTALL_RPATH=ON -D BUILD_TESTING=OFF -W no-dev \
		-D BUILD_QCH=OFF -D BUILD_PYTHON_BINDINGS=OFF
	ninja -C build
}

package() {
	DESTDIR="$pkgdir" ninja -C build install
}
