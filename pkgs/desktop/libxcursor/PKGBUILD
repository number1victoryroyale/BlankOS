# Maintainer: BlankOS <builds@blankos.invalid>
# Based on BLFS 13.1 (systemd)

pkgname=libxcursor
pkgver=1.2.3
pkgrel=1
pkgdesc="X cursor management library"
arch=(x86_64)
url='https://xorg.freedesktop.org/'
license=('MIT')
depends=('libxfixes' 'libxrender')
makedepends=('xorgproto' 'xorg-util-macros' 'xtrans')
source=("https://www.x.org/pub/individual/lib/libXcursor-$pkgver.tar.xz")
sha256sums=('fde9402dd4cfe79da71e2d96bb980afc5e6ff4f8a7d74c159e1966afb2b2c2c0')

build() {
	cd "libXcursor-$pkgver"
	./configure --prefix=/usr --sysconfdir=/etc --localstatedir=/var --disable-static
	make
}

package() {
	cd "libXcursor-$pkgver"
	make DESTDIR="$pkgdir" install
}
