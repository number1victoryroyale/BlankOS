# Maintainer: BlankOS <builds@blankos.invalid>
# Based on BLFS 13.1 (systemd)

pkgname=libinput
pkgver=1.31.3
pkgrel=1
pkgdesc="Input device management and event handling library"
arch=(x86_64)
url='https://gitlab.freedesktop.org/libinput/libinput'
license=('MIT')
depends=('mtdev' 'libevdev' 'libwacom' 'systemd')
source=("https://gitlab.freedesktop.org/libinput/libinput/-/archive/$pkgver/libinput-$pkgver.tar.gz")
sha256sums=('b6749bf6f1890f6631c0a70a027c35fec9d2e096a39f720548896e41474a9854')

build() {
	meson setup build "libinput-$pkgver" --prefix=/usr --buildtype=release \
		-D debug-gui=false -D tests=false -D libwacom=true -D documentation=false -D udev-dir=/usr/lib/udev
	ninja -C build
}

package() {
	DESTDIR="$pkgdir" ninja -C build install
}
