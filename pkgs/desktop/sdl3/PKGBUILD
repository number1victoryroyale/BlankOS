# Maintainer: BlankOS <builds@blankos.invalid>
# Based on BLFS 13.1 (systemd)

pkgname=sdl3
pkgver=3.4.14
pkgrel=1
pkgdesc="A library for portable low-level access to a video framebuffer, audio output, mouse, and keyboard (Version 3)"
arch=(x86_64)
url='https://www.libsdl.org'
license=('Zlib')
depends=('glibc' 'libxext' 'libxrender' 'libx11' 'libxkbcommon' 'wayland' 'libglvnd' 'libpulse' 'pipewire' 'alsa-lib' 'libdrm' 'mesa' 'libusb' 'systemd' 'libxcursor' 'libxi' 'libxrandr' 'libxss' 'dbus')
makedepends=('cmake' 'ninja' 'wayland-protocols' 'vulkan-headers' 'xorgproto')
source=("https://www.libsdl.org/release/SDL3-$pkgver.tar.gz"
        "https://www.linuxfromscratch.org/patches/blfs/13.1/SDL3-3.4.14-upstream_fixes-1.patch")
sha256sums=('30d4aa2b3037718142b32dffd4e72f917ebb6cc5227150e7bb9c45efb2153aeb'
            '4269bc9e7163dcceba1ae0be9e534548e8c49166c67edfdf130a0673137dbb41')

prepare() {
	cd "SDL3-$pkgver"
	patch -Np1 -i ../SDL3-3.4.14-upstream_fixes-1.patch
}

build() {
	cmake -S "SDL3-$pkgver" -B build -G Ninja -D CMAKE_INSTALL_PREFIX=/usr \
		-D CMAKE_BUILD_TYPE=Release -D CMAKE_INSTALL_LIBDIR=lib -D CMAKE_INSTALL_LIBEXECDIR=lib \
		-D CMAKE_SKIP_INSTALL_RPATH=ON -D BUILD_TESTING=OFF -W no-dev \
		-D SDL_TEST_LIBRARY=OFF -D SDL_STATIC=OFF -D SDL_RPATH=OFF
	ninja -C build
}

package() {
	DESTDIR="$pkgdir" ninja -C build install
}
