# Maintainer: BlankOS <builds@blankos.invalid>
# Based on BLFS 13.1 (systemd) and Arch Linux's syndication

pkgname=syndication
pkgver=6.29.0
pkgrel=1
pkgdesc="RSS/Atom parser library"
arch=(x86_64)
url='https://develop.kde.org/products/frameworks/'
license=('LGPL-2.0-only' 'LGPL-3.0-only')
depends=('glibc' 'kcodecs' 'gcc-libs' 'qt6-base')
makedepends=('cmake' 'ninja' 'extra-cmake-modules' 'qt6-tools')
source=("https://download.kde.org/stable/frameworks/${pkgver%.*}/syndication-$pkgver.tar.xz")
sha256sums=('f5a00d13eaf0401e9e4f3ffccda4876e2bcf84fb8dc2613a5d087971b377df1f')

build() {
	cmake -S "syndication-$pkgver" -B build -G Ninja -D CMAKE_INSTALL_PREFIX=/usr \
		-D CMAKE_BUILD_TYPE=Release -D CMAKE_INSTALL_LIBDIR=lib -D CMAKE_INSTALL_LIBEXECDIR=lib \
		-D CMAKE_SKIP_INSTALL_RPATH=ON -D BUILD_TESTING=OFF -W no-dev \
		-D BUILD_QCH=OFF -D BUILD_PYTHON_BINDINGS=OFF
	ninja -C build
}

package() {
	DESTDIR="$pkgdir" ninja -C build install
}
