# Maintainer: BlankOS <builds@blankos.invalid>
# Based on BLFS 13.1 (systemd) and Arch Linux's kscreenlocker

pkgname=kscreenlocker
pkgver=6.7.4
pkgrel=1
pkgdesc="Library and components for secure lock screen architecture"
arch=(x86_64)
url='https://kde.org/plasma-desktop/'
license=('LGPL-2.0-or-later')
depends=('glibc' 'kcmutils' 'kconfig' 'kcoreaddons' 'kcrash' 'kdeclarative' 'kglobalaccel' 'ki18n' 'kidletime' 'kio' 'kirigami' 'knotifications' 'kpackage' 'ksvg' 'kwindowsystem' 'kxmlgui' 'layer-shell-qt' 'libkscreen' 'libplasma' 'gcc-libs' 'qt6-base' 'qt6-declarative' 'linux-pam')
makedepends=('cmake' 'ninja' 'extra-cmake-modules' 'qt6-tools' 'kdoctools')
source=("https://download.kde.org/stable/plasma/$pkgver/kscreenlocker-$pkgver.tar.xz"
        "kde.pam")
sha256sums=('f9cd525d501f08931f2c0b4d08f5384588967bc89fac62e39ed4ae2da2925a39'
            '18aaaf749d9e37dfc6b828f004e2d91ab4bfd48b0480719492b025ab88f8b7b3')

build() {
	cmake -S "kscreenlocker-$pkgver" -B build -G Ninja -D CMAKE_INSTALL_PREFIX=/usr \
		-D CMAKE_BUILD_TYPE=Release -D CMAKE_INSTALL_LIBDIR=lib -D CMAKE_INSTALL_LIBEXECDIR=lib \
		-D CMAKE_SKIP_INSTALL_RPATH=ON -D BUILD_TESTING=OFF -W no-dev \
		-D BUILD_QT5=OFF
	ninja -C build
}

package() {
	DESTDIR="$pkgdir" ninja -C build install
	install -Dm644 "$srcdir/kde.pam" "$pkgdir/usr/lib/pam.d/kde"
}
