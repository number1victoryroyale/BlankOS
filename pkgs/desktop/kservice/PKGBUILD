# Maintainer: BlankOS <builds@blankos.invalid>
# Based on BLFS 13.1 (systemd) and Arch Linux's kservice

pkgname=kservice
pkgver=6.29.0
pkgrel=1
pkgdesc="Advanced plugin and service introspection"
arch=(x86_64)
url='https://develop.kde.org/products/frameworks/'
license=('LGPL-2.0-only' 'LGPL-3.0-only')
depends=('glibc' 'kconfig' 'kcoreaddons' 'ki18n' 'gcc-libs' 'qt6-base')
makedepends=('cmake' 'ninja' 'extra-cmake-modules' 'qt6-tools' 'kdoctools')
source=("https://download.kde.org/stable/frameworks/${pkgver%.*}/kservice-$pkgver.tar.xz")
sha256sums=('0ebde9435d0c0badecec2f96daef972de7b5600d92dddbfc1f5f81c01cfff87c')

build() {
	cmake -S "kservice-$pkgver" -B build -G Ninja -D CMAKE_INSTALL_PREFIX=/usr \
		-D CMAKE_BUILD_TYPE=Release -D CMAKE_INSTALL_LIBDIR=lib -D CMAKE_INSTALL_LIBEXECDIR=lib \
		-D CMAKE_SKIP_INSTALL_RPATH=ON -D BUILD_TESTING=OFF -W no-dev \
		-D BUILD_QCH=OFF -D BUILD_PYTHON_BINDINGS=OFF
	ninja -C build
}

package() {
	DESTDIR="$pkgdir" ninja -C build install
}
