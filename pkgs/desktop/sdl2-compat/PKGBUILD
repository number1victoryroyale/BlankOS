# Maintainer: BlankOS <builds@blankos.invalid>
# Based on BLFS 13.1 (systemd)

pkgname=sdl2-compat
pkgver=2.32.70
pkgrel=1
pkgdesc="An SDL2 compatibility layer that uses SDL3 behind the scenes"
arch=(x86_64)
url='https://github.com/libsdl-org/sdl2-compat'
license=('Zlib')
depends=('sdl3')
makedepends=('cmake' 'ninja')
provides=('sdl2')
source=("https://www.libsdl.org/release/sdl2-compat-$pkgver.tar.gz")
sha256sums=('998fa62557eb46ffe7e5c3e2c123bc332f7df9d9f593b3ceed88ed1158428a44')

build() {
	cmake -S "sdl2-compat-$pkgver" -B build -G Ninja -D CMAKE_INSTALL_PREFIX=/usr \
		-D CMAKE_BUILD_TYPE=Release -D CMAKE_INSTALL_LIBDIR=lib -D CMAKE_INSTALL_LIBEXECDIR=lib \
		-D CMAKE_SKIP_INSTALL_RPATH=ON -D BUILD_TESTING=OFF -W no-dev \
		-D SDL2COMPAT_STATIC=OFF -D SDL2COMPAT_TESTS=OFF
	ninja -C build
}

package() {
	DESTDIR="$pkgdir" ninja -C build install
	rm -f "$pkgdir/usr/lib/libSDL2_test.a"
}
