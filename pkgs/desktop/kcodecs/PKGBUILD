# Maintainer: BlankOS <builds@blankos.invalid>
# Based on BLFS 13.1 (systemd) and Arch Linux's kcodecs

pkgname=kcodecs
pkgver=6.29.0
pkgrel=1
pkgdesc="Provide a collection of methods to manipulate strings using various encodings"
arch=(x86_64)
url='https://develop.kde.org/products/frameworks/'
license=('LGPL-2.0-only' 'LGPL-3.0-only')
depends=('glibc' 'gcc-libs' 'qt6-base')
makedepends=('cmake' 'ninja' 'extra-cmake-modules' 'qt6-tools' 'gperf')
source=("https://download.kde.org/stable/frameworks/${pkgver%.*}/kcodecs-$pkgver.tar.xz")
sha256sums=('0480fc5319346b0e24c6e363abce883a889735a7b71ad56d75eae2f7ae553d99')

build() {
	cmake -S "kcodecs-$pkgver" -B build -G Ninja -D CMAKE_INSTALL_PREFIX=/usr \
		-D CMAKE_BUILD_TYPE=Release -D CMAKE_INSTALL_LIBDIR=lib -D CMAKE_INSTALL_LIBEXECDIR=lib \
		-D CMAKE_SKIP_INSTALL_RPATH=ON -D BUILD_TESTING=OFF -W no-dev \
		-D BUILD_QCH=OFF -D BUILD_PYTHON_BINDINGS=OFF
	ninja -C build
}

package() {
	DESTDIR="$pkgdir" ninja -C build install
}
