# Maintainer: BlankOS <builds@blankos.invalid>
# Based on BLFS 13.1 (systemd): the calculator in Plasma's search (KRunner)

pkgname=libqalculate
pkgver=5.12.0
pkgrel=1
pkgdesc="Multi-purpose desktop calculator library"
arch=(x86_64)
url='https://qalculate.github.io/'
license=('GPL-2.0-or-later')
depends=('gmp' 'mpfr' 'icu' 'libxml2' 'curl' 'readline')
makedepends=('perl' 'gettext')
source=("https://github.com/Qalculate/libqalculate/releases/download/v$pkgver/libqalculate-$pkgver.tar.gz")
sha256sums=('f3dfdcf97d5a9e3a5bc0ebe66afd184721b606276eee3ba0ada8c92a5e71d44c')

build() {
	cd "libqalculate-$pkgver"
	./configure --prefix=/usr --disable-static
	make
}

package() {
	cd "libqalculate-$pkgver"
	make DESTDIR="$pkgdir" install
}
