# Maintainer: BlankOS <builds@blankos.invalid>
# Based on BLFS 13.1 (systemd) and Arch Linux's pulseaudio-qt

pkgname=pulseaudio-qt
pkgver=1.8.1
pkgrel=1
pkgdesc="Qt bindings for libpulse"
arch=(x86_64)
url='https://community.kde.org/Frameworks'
license=('LGPL-2.1-only' 'LGPL-3.0-only')
depends=('glibc' 'libpulse' 'gcc-libs' 'qt6-base')
makedepends=('cmake' 'ninja' 'extra-cmake-modules' 'qt6-tools')
source=("https://download.kde.org/stable/pulseaudio-qt/pulseaudio-qt-$pkgver.tar.xz")
sha256sums=('79619c55b94808aa7d307fb234ad39a1096d088f21f806be0e788be79a76b3c9')

build() {
	cmake -S "pulseaudio-qt-$pkgver" -B build -G Ninja -D CMAKE_INSTALL_PREFIX=/usr \
		-D CMAKE_BUILD_TYPE=Release -D CMAKE_INSTALL_LIBDIR=lib -D CMAKE_INSTALL_LIBEXECDIR=lib \
		-D CMAKE_SKIP_INSTALL_RPATH=ON -D BUILD_TESTING=OFF -W no-dev \
		-D BUILD_QCH=OFF
	ninja -C build
}

package() {
	DESTDIR="$pkgdir" ninja -C build install
}
