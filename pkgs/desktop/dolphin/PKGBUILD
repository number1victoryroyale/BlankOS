# Maintainer: BlankOS <builds@blankos.invalid>
# Based on BLFS 13.1 (systemd) and Arch Linux's dolphin

pkgname=dolphin
pkgver=26.04.3
pkgrel=1
pkgdesc="KDE File Manager"
arch=(x86_64)
url='https://apps.kde.org/dolphin/'
license=('LGPL-2.0-or-later')
depends=('baloo' 'baloo-widgets' 'glibc' 'kbookmarks' 'kcmutils' 'kcodecs' 'kcolorscheme' 'kcompletion' 'kconfig' 'kconfigwidgets' 'kcoreaddons' 'kcrash' 'kdbusaddons' 'kfilemetadata' 'kguiaddons' 'ki18n' 'kiconthemes' 'kio' 'kjobwidgets' 'knewstuff' 'knotifications' 'kparts' 'kservice' 'ktextwidgets' 'kuserfeedback' 'kwidgetsaddons' 'kwindowsystem' 'kxmlgui' 'gcc-libs' 'qt6-base' 'qt6-multimedia' 'solid')
makedepends=('cmake' 'ninja' 'extra-cmake-modules' 'qt6-tools' 'kdoctools')
source=("https://download.kde.org/stable/release-service/$pkgver/src/dolphin-$pkgver.tar.xz")
sha256sums=('d18579587f841ca5a571c3614bda0beed6e53bf5ded4d456009e187cbb9d0b44')

build() {
	cmake -S "dolphin-$pkgver" -B build -G Ninja -D CMAKE_INSTALL_PREFIX=/usr \
		-D CMAKE_BUILD_TYPE=Release -D CMAKE_INSTALL_LIBDIR=lib -D CMAKE_INSTALL_LIBEXECDIR=lib \
		-D CMAKE_SKIP_INSTALL_RPATH=ON -D BUILD_TESTING=OFF -W no-dev \
		-D BUILD_QCH=OFF
	ninja -C build
}

package() {
	DESTDIR="$pkgdir" ninja -C build install
}
