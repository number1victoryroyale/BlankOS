# Maintainer: BlankOS <builds@blankos.invalid>
# Based on BLFS 13.1 (systemd) and Arch Linux's plasma-activities-stats

pkgname=plasma-activities-stats
pkgver=6.7.4
pkgrel=1
pkgdesc="A library for accessing the usage data collected by the activities system"
arch=(x86_64)
url='https://kde.org/plasma-desktop/'
license=('LGPL-2.0-or-later')
depends=('glibc' 'kconfig' 'gcc-libs' 'plasma-activities' 'qt6-base')
makedepends=('cmake' 'ninja' 'extra-cmake-modules' 'qt6-tools')
source=("https://download.kde.org/stable/plasma/$pkgver/plasma-activities-stats-$pkgver.tar.xz")
sha256sums=('98b888372c7f74c60b02af6e1ca8b18fe8262748febf5e0480bd0ecc9e2bddef')

build() {
	cmake -S "plasma-activities-stats-$pkgver" -B build -G Ninja -D CMAKE_INSTALL_PREFIX=/usr \
		-D CMAKE_BUILD_TYPE=Release -D CMAKE_INSTALL_LIBDIR=lib -D CMAKE_INSTALL_LIBEXECDIR=lib \
		-D CMAKE_SKIP_INSTALL_RPATH=ON -D BUILD_TESTING=OFF -W no-dev \
		-D BUILD_QT5=OFF
	ninja -C build
}

package() {
	DESTDIR="$pkgdir" ninja -C build install
}
