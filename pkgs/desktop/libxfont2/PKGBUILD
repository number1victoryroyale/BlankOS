# Maintainer: BlankOS <builds@blankos.invalid>
# Based on BLFS 13.1 (systemd)

pkgname=libxfont2
pkgver=2.0.9
pkgrel=1
pkgdesc="X11 font rasterisation library"
arch=(x86_64)
url='https://xorg.freedesktop.org/'
license=('MIT')
depends=('freetype2' 'libfontenc')
makedepends=('xorgproto' 'xorg-util-macros' 'xtrans')
source=("https://www.x.org/pub/individual/lib/libXfont2-$pkgver.tar.xz")
sha256sums=('f042a370666815e7b941e9b7019024755bd1c6c2954afbfa515af378251799e2')

build() {
	cd "libXfont2-$pkgver"
	./configure --prefix=/usr --sysconfdir=/etc --localstatedir=/var --disable-static \
		--disable-devel-docs
	make
}

package() {
	cd "libXfont2-$pkgver"
	make DESTDIR="$pkgdir" install
}
