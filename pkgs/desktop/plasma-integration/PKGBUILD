# Maintainer: BlankOS <builds@blankos.invalid>
# Based on BLFS 13.1 (systemd) and Arch Linux's plasma-integration

pkgname=plasma-integration
pkgver=6.7.4
pkgrel=1
pkgdesc="Qt Platform Theme integration plugins for the Plasma workspaces"
arch=(x86_64)
url='https://kde.org/plasma-desktop/'
license=('LGPL-2.0-or-later')
depends=('glibc' 'kcolorscheme' 'kconfig' 'kcoreaddons' 'kguiaddons' 'ki18n' 'kiconthemes' 'kio' 'kjobwidgets' 'knotifications' 'kservice' 'kstatusnotifieritem' 'kwidgetsaddons' 'kwindowsystem' 'gcc-libs' 'libxcb' 'libxcursor' 'noto-fonts' 'qqc2-breeze-style' 'qqc2-desktop-style' 'qt6-base' 'qt6-declarative' 'ttf-hack' 'wayland' 'xdg-desktop-portal-kde')
makedepends=('cmake' 'ninja' 'extra-cmake-modules' 'qt6-tools' 'plasma-wayland-protocols')
source=("https://download.kde.org/stable/plasma/$pkgver/plasma-integration-$pkgver.tar.xz")
sha256sums=('54e65b1170499ccc567f9bb7586809d4739ea728efcf1bc877d1709db6e7347a')

build() {
	cmake -S "plasma-integration-$pkgver" -B build -G Ninja -D CMAKE_INSTALL_PREFIX=/usr \
		-D CMAKE_BUILD_TYPE=Release -D CMAKE_INSTALL_LIBDIR=lib -D CMAKE_INSTALL_LIBEXECDIR=lib \
		-D CMAKE_SKIP_INSTALL_RPATH=ON -D BUILD_TESTING=OFF -W no-dev \
		-D BUILD_QT5=OFF
	ninja -C build
}

package() {
	DESTDIR="$pkgdir" ninja -C build install
}
