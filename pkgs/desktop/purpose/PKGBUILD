# Maintainer: BlankOS <builds@blankos.invalid>
# Based on BLFS 13.1 (systemd) and Arch Linux's purpose

pkgname=purpose
pkgver=6.29.0
pkgrel=1
pkgdesc="Framework for providing abstractions to get the developers purposes fulfilled"
arch=(x86_64)
url='https://develop.kde.org/products/frameworks/'
license=('LGPL-2.0-only' 'LGPL-3.0-only')
depends=('glibc' 'hicolor-icon-theme' 'kcmutils' 'kconfig' 'kcoreaddons' 'ki18n' 'kio' 'kirigami' 'kitemmodels' 'knotifications' 'kservice' 'gcc-libs' 'qt6-base' 'qt6-declarative')
makedepends=('cmake' 'ninja' 'extra-cmake-modules' 'qt6-tools' 'prison')
source=("https://download.kde.org/stable/frameworks/${pkgver%.*}/purpose-$pkgver.tar.xz")
sha256sums=('743445e6a1b3aee156aec6e84ac8d36161124784f9e5730b69b868fdd6fb79c2')

build() {
	cmake -S "purpose-$pkgver" -B build -G Ninja -D CMAKE_INSTALL_PREFIX=/usr \
		-D CMAKE_BUILD_TYPE=Release -D CMAKE_INSTALL_LIBDIR=lib -D CMAKE_INSTALL_LIBEXECDIR=lib \
		-D CMAKE_SKIP_INSTALL_RPATH=ON -D BUILD_TESTING=OFF -W no-dev \
		-D BUILD_QCH=OFF -D BUILD_PYTHON_BINDINGS=OFF
	ninja -C build
}

package() {
	DESTDIR="$pkgdir" ninja -C build install
}
