# Maintainer: BlankOS <builds@blankos.invalid>
# Based on the AUR's calamares. The installer framework; BlankOS's
# settings and branding are in blankos-installer.

pkgname=calamares
pkgver=3.3.14
pkgrel=1
pkgdesc="Distribution-independent installer framework"
arch=(x86_64)
url='https://calamares.io/'
license=('GPL-3.0-or-later')
depends=('qt6-base' 'qt6-svg' 'qt6-declarative' 'kcoreaddons' 'kcrash' 'kdbusaddons' 'kpmcore' 'yaml-cpp'
         'polkit-qt6' 'python' 'rsync' 'efibootmgr' 'dosfstools' 'grub' 'polkit')
makedepends=('cmake' 'ninja' 'extra-cmake-modules' 'qt6-tools')
source=("https://github.com/calamares/calamares/releases/download/v$pkgver/calamares-$pkgver.tar.gz")
sha256sums=('5547f80db067dea923ae693ba6bb88eb2b2eeac1da3ebec42fce453e31c290c0')

build() {
	cmake -S "calamares-$pkgver" -B build -G Ninja -D CMAKE_INSTALL_PREFIX=/usr \
		-D CMAKE_BUILD_TYPE=Release -D CMAKE_INSTALL_LIBDIR=lib \
		-D WITH_QT6=ON -D WITH_PYTHON=ON -D WITH_PYBIND11=ON -D WITH_PYTHONQT=OFF \
		-D WITH_APPSTREAM=OFF -D BUILD_TESTING=OFF -D INSTALL_CONFIG=ON \
		-D SKIP_MODULES="webview interactiveterminal initramfs initramfscfg dracut dracutlukscfg dummyprocess dummypython dummycpp dummypythonqt services-openrc openrcdmcryptcfg plymouthcfg tracking zfs zfshostid luksbootkeyfile luksopenswaphookcfg mkinitfs rawfs packagechooser packagechooserq netinstall packages"
	cmake --build build
}

package() {
	DESTDIR="$pkgdir" cmake --install build
}
