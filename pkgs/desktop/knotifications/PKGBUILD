# Maintainer: BlankOS <builds@blankos.invalid>
# Based on BLFS 13.1 (systemd) and Arch Linux's knotifications

pkgname=knotifications
pkgver=6.29.0
pkgrel=1
pkgdesc="Abstraction for system notifications"
arch=(x86_64)
url='https://develop.kde.org/products/frameworks/'
license=('LGPL-2.0-only' 'LGPL-3.0-only')
depends=('glibc' 'kconfig' 'libcanberra' 'gcc-libs' 'qt6-base')
makedepends=('cmake' 'ninja' 'extra-cmake-modules' 'qt6-tools' 'python-setuptools' 'qt6-declarative')
source=("https://download.kde.org/stable/frameworks/${pkgver%.*}/knotifications-$pkgver.tar.xz")
sha256sums=('883e0139fcbc692070287e47de5368c78eb91c8bdbb52fb6f8398183f6aace8f')

build() {
	cmake -S "knotifications-$pkgver" -B build -G Ninja -D CMAKE_INSTALL_PREFIX=/usr \
		-D CMAKE_BUILD_TYPE=Release -D CMAKE_INSTALL_LIBDIR=lib -D CMAKE_INSTALL_LIBEXECDIR=lib \
		-D CMAKE_SKIP_INSTALL_RPATH=ON -D BUILD_TESTING=OFF -W no-dev \
		-D BUILD_QCH=OFF -D BUILD_PYTHON_BINDINGS=OFF
	ninja -C build
}

package() {
	DESTDIR="$pkgdir" ninja -C build install
}
