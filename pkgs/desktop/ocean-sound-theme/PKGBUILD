# Maintainer: BlankOS <builds@blankos.invalid>
# Based on BLFS 13.1 (systemd) and Arch Linux's ocean-sound-theme

pkgname=ocean-sound-theme
pkgver=6.7.4
pkgrel=1
pkgdesc="Ocean Sound Theme for Plasma"
arch=(x86_64)
url='https://kde.org/plasma-desktop/'
license=('LGPL-2.0-or-later')
makedepends=('cmake' 'ninja' 'extra-cmake-modules' 'qt6-tools' 'qt6-base')
source=("https://download.kde.org/stable/plasma/$pkgver/ocean-sound-theme-$pkgver.tar.xz")
sha256sums=('3d0368e992388fce0015e3622778062a67827b660bae6ab551e873ae18a3045c')

build() {
	cmake -S "ocean-sound-theme-$pkgver" -B build -G Ninja -D CMAKE_INSTALL_PREFIX=/usr \
		-D CMAKE_BUILD_TYPE=Release -D CMAKE_INSTALL_LIBDIR=lib -D CMAKE_INSTALL_LIBEXECDIR=lib \
		-D CMAKE_SKIP_INSTALL_RPATH=ON -D BUILD_TESTING=OFF -W no-dev \
		-D BUILD_QT5=OFF
	ninja -C build
}

package() {
	DESTDIR="$pkgdir" ninja -C build install
}
