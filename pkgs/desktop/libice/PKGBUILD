# Maintainer: BlankOS <builds@blankos.invalid>
# Based on BLFS 13.1 (systemd)

pkgname=libice
pkgver=1.1.2
pkgrel=1
pkgdesc="X11 Inter-Client Exchange library"
arch=(x86_64)
url='https://xorg.freedesktop.org/'
license=('MIT')
depends=('glibc')
makedepends=('xorgproto' 'xorg-util-macros' 'xtrans')
source=("https://www.x.org/pub/individual/lib/libICE-$pkgver.tar.xz")
sha256sums=('974e4ed414225eb3c716985df9709f4da8d22a67a2890066bc6dfc89ad298625')

build() {
	cd "libICE-$pkgver"
	./configure --prefix=/usr --sysconfdir=/etc --localstatedir=/var --disable-static
	make
}

package() {
	cd "libICE-$pkgver"
	make DESTDIR="$pkgdir" install
}
