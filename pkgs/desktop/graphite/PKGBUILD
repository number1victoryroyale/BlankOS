# Maintainer: BlankOS <builds@blankos.invalid>
# Based on Arch Linux's graphite package

pkgname=graphite
pkgver=1.3.14
pkgrel=1
pkgdesc="reimplementation of the SIL Graphite text processing engine"
arch=(x86_64)
url='https://github.com/silnrsi/graphite'
license=('LGPL-2.1-or-later OR MPL-2.0 OR GPL-2.0-or-later')
depends=('gcc-libs')
source=("https://github.com/silnrsi/graphite/releases/download/$pkgver/graphite2-$pkgver.tgz")
sha256sums=('f99d1c13aa5fa296898a181dff9b82fb25f6cc0933dbaa7a475d8109bd54209d')

prepare() {
	cd "graphite2-$pkgver"
	# the tests do not build with GCC 16 (and are not run)
	sed -i '/add_subdirectory(tests)/d; /add_subdirectory(doc)/d' CMakeLists.txt
}

build() {
	cmake -S "graphite2-$pkgver" -B build -G Ninja -D CMAKE_INSTALL_PREFIX=/usr \
		-D CMAKE_BUILD_TYPE=Release -D CMAKE_INSTALL_LIBDIR=lib -D CMAKE_INSTALL_LIBEXECDIR=lib \
		-D CMAKE_SKIP_INSTALL_RPATH=ON -D BUILD_TESTING=OFF -W no-dev \
		-D GRAPHITE2_COMPARE_RENDERER=OFF -D CMAKE_POLICY_VERSION_MINIMUM=3.5
	ninja -C build
}

package() {
	DESTDIR="$pkgdir" ninja -C build install
}
