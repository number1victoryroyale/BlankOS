# Maintainer: BlankOS <builds@blankos.invalid>
# Based on BLFS 13.1 (systemd)

pkgname=xkeyboard-config
pkgver=2.48
pkgrel=1
pkgdesc="X keyboard configuration files"
arch=(any)
url='https://www.freedesktop.org/wiki/Software/XKeyboardConfig'
license=('MIT')
makedepends=('python')
source=("https://www.x.org/pub/individual/data/xkeyboard-config/xkeyboard-config-$pkgver.tar.xz")
sha256sums=('b77041324f0109f77161ee43743fe04baa485866af8460d31e476ad3f7648fd5')

build() {
	meson setup build "xkeyboard-config-$pkgver" --prefix=/usr --buildtype=release
	ninja -C build
}

package() {
	DESTDIR="$pkgdir" ninja -C build install
}
