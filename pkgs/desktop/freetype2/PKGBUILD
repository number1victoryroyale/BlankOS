# Maintainer: BlankOS <builds@blankos.invalid>
# Based on BLFS 13.1 (systemd)

pkgname=freetype2
pkgver=2.14.3
pkgrel=1
pkgdesc="Font rasterization library"
arch=(x86_64)
url='https://freetype.org/'
license=('FTL OR GPL-2.0-or-later')
depends=('bzip2' 'zlib' 'libpng' 'brotli')
source=("https://downloads.sourceforge.net/freetype/freetype-$pkgver.tar.xz")
sha256sums=('36bc4f1cc413335368ee656c42afca65c5a3987e8768cc28cf11ba775e785a5f')

prepare() {
	cd "freetype-$pkgver"
	sed -ri "s:.*(AUX_MODULES.*valid):\1:" modules.cfg
	sed -r "s:.*(#.*SUBPIXEL_RENDERING) .*:\1:" -i include/freetype/config/ftoption.h
}

build() {
	cd "freetype-$pkgver"
	./configure --prefix=/usr --sysconfdir=/etc --localstatedir=/var --disable-static \
		--enable-freetype-config --with-harfbuzz=dynamic
	make
}

package() {
	cd "freetype-$pkgver"
	make DESTDIR="$pkgdir" install
}
