# Maintainer: BlankOS <builds@blankos.invalid>
# Based on BLFS 13.1 (systemd) and Arch Linux's ki18n

pkgname=ki18n
pkgver=6.29.0
pkgrel=1
pkgdesc="Advanced internationalization framework"
arch=(x86_64)
url='https://develop.kde.org/products/frameworks/'
license=('LGPL-2.0-only' 'LGPL-3.0-only')
depends=('glibc' 'gcc-libs' 'qt6-base' 'iso-codes')
makedepends=('cmake' 'ninja' 'extra-cmake-modules' 'qt6-tools' 'python' 'qt6-declarative')
source=("https://download.kde.org/stable/frameworks/${pkgver%.*}/ki18n-$pkgver.tar.xz")
sha256sums=('9037f3caa67768869f00ee257dbb35b81febe6ad600ed0bd3ffdf293c36252ba')

build() {
	cmake -S "ki18n-$pkgver" -B build -G Ninja -D CMAKE_INSTALL_PREFIX=/usr \
		-D CMAKE_BUILD_TYPE=Release -D CMAKE_INSTALL_LIBDIR=lib -D CMAKE_INSTALL_LIBEXECDIR=lib \
		-D CMAKE_SKIP_INSTALL_RPATH=ON -D BUILD_TESTING=OFF -W no-dev \
		-D BUILD_QCH=OFF -D BUILD_PYTHON_BINDINGS=OFF
	ninja -C build
}

package() {
	DESTDIR="$pkgdir" ninja -C build install
}
