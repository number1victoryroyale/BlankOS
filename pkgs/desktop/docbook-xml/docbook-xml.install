_cat=/usr/share/xml/docbook/xml-dtd-4.5/catalog.xml

post_install() {
	[ -e /etc/xml/catalog ] || { install -d /etc/xml; xmlcatalog --noout --create /etc/xml/catalog; }
	xmlcatalog --noout --add "delegatePublic" "-//OASIS//ENTITIES DocBook XML" "file://$_cat" /etc/xml/catalog
	xmlcatalog --noout --add "delegatePublic" "-//OASIS//DTD DocBook XML" "file://$_cat" /etc/xml/catalog
	xmlcatalog --noout --add "delegateSystem" "http://www.oasis-open.org/docbook/" "file://$_cat" /etc/xml/catalog
	xmlcatalog --noout --add "delegateURI" "http://www.oasis-open.org/docbook/" "file://$_cat" /etc/xml/catalog
}

post_upgrade() {
	post_install
}

pre_remove() {
	xmlcatalog --noout --del "file://$_cat" /etc/xml/catalog
}
