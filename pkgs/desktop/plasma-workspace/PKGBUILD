# Maintainer: BlankOS <builds@blankos.invalid>
# Based on BLFS 13.1 (systemd) and Arch Linux's plasma-workspace

pkgname=plasma-workspace
pkgver=6.7.4
pkgrel=1
pkgdesc="KDE Plasma Workspace"
arch=(x86_64)
url='https://kde.org/plasma-desktop/'
license=('LGPL-2.0-or-later')
depends=('libxft' 'libqalculate' 'qt6-location' 'qt6-positioning' 'appstream-qt' 'dbus' 'fontconfig' 'freetype2' 'glibc' 'icu' 'kactivitymanagerd' 'karchive' 'kauth' 'kbookmarks' 'kcmutils' 'kcolorscheme' 'kcompletion' 'kconfig' 'kconfigwidgets' 'kcoreaddons' 'kcrash' 'kdbusaddons' 'kde-cli-tools' 'kdeclarative' 'kded' 'kglobalaccel' 'kguiaddons' 'kholidays' 'ki18n' 'kiconthemes' 'kidletime' 'kio' 'kirigami' 'kirigami-addons' 'kitemmodels' 'kjobwidgets' 'knewstuff' 'knighttime' 'knotifications' 'kpackage' 'kparts' 'kpipewire' 'kquickcharts' 'krunner' 'kscreenlocker' 'kservice' 'kstatusnotifieritem' 'ksvg' 'ksystemstats' 'ktexteditor' 'ktextwidgets' 'kuserfeedback' 'kwallet' 'kwayland' 'kwidgetsaddons' 'kwin' 'kwindowsystem' 'kxmlgui' 'layer-shell-qt' 'libcanberra' 'gcc-libs' 'libice' 'libksysguard' 'libplasma' 'libsm' 'libx11' 'libxau' 'libxcb' 'libxcrypt' 'libxtst' 'milou' 'ocean-sound-theme' 'plasma-activities' 'plasma-activities-stats' 'plasma-integration' 'prison' 'qt6-5compat' 'qt6-base' 'qt6-declarative' 'qt6-svg' 'qt6-tools' 'sh' 'solid' 'systemd' 'wayland' 'xcb-util' 'xcb-util-cursor' 'xcb-util-image' 'xcb-util-wm' 'xorg-xwayland' 'zlib' 'xdg-desktop-portal-kde' 'iso-codes')
makedepends=('cmake' 'ninja' 'extra-cmake-modules' 'baloo' 'kdoctools' 'networkmanager-qt' 'plasma-wayland-protocols' 'qcoro')
source=("https://download.kde.org/stable/plasma/$pkgver/plasma-workspace-$pkgver.tar.xz")
sha256sums=('21ec3c002929eb65377a1ae0eb105b9ab6f608049dac5493e188f51bd50398d5')

build() {
	cmake -S "plasma-workspace-$pkgver" -B build -G Ninja -D CMAKE_INSTALL_PREFIX=/usr \
		-D CMAKE_BUILD_TYPE=Release -D CMAKE_INSTALL_LIBDIR=lib -D CMAKE_INSTALL_LIBEXECDIR=lib \
		-D CMAKE_SKIP_INSTALL_RPATH=ON -D BUILD_TESTING=OFF -W no-dev \
		-D BUILD_QT5=OFF -D GLIBC_LOCALE_GEN=OFF
	ninja -C build
}

package() {
	DESTDIR="$pkgdir" ninja -C build install
}
