# Maintainer: BlankOS <builds@blankos.invalid>
# Based on BLFS 13.1 (systemd) and Arch Linux's qt6-positioning
# Needed by Plasma (night light location, weather).

pkgname=qt6-positioning
_qtver=6.11.2
pkgver=$_qtver
pkgrel=1
pkgdesc="Provides access to position, satellite info and area monitoring classes"
arch=(x86_64)
url='https://www.qt.io'
license=('GPL-3.0-only' 'LGPL-3.0-only' 'LicenseRef-Qt-Commercial')
depends=('glibc' 'gcc-libs' 'qt6-base' 'qt6-declarative')
makedepends=('cmake' 'ninja' 'qt6-declarative')
source=("https://download.qt.io/official_releases/qt/${pkgver%.*}/$pkgver/submodules/qtpositioning-everywhere-src-$pkgver.tar.xz")
sha256sums=('d8cf15ad43a3b1520adac64cec5900028525cf75f01a4c82a0002e7ac1ae7499')

build() {
	cmake -S "qtpositioning-everywhere-src-$pkgver" -B build -G Ninja -D CMAKE_MESSAGE_LOG_LEVEL=STATUS \
		-D CMAKE_BUILD_TYPE=Release -D QT_BUILD_TESTS=OFF -D QT_BUILD_EXAMPLES=OFF \
		-D FEATURE_geoclue2=OFF -D FEATURE_gypsy=OFF
	cmake --build build
}

package() {
	DESTDIR="$pkgdir" cmake --install build
	install -Dm644 "qtpositioning-everywhere-src-$pkgver/LICENSES"/* -t "$pkgdir/usr/share/licenses/$pkgname"

	# Qt also writes these links relative to the prefix (/usr/usr/bin)
	rm -rf "$pkgdir/usr/usr"
	# user-facing tools (qmake6, qdbus6, ...) in /usr/bin
	if [[ -f $srcdir/build/user_facing_tool_links.txt ]]; then
		cd "$pkgdir"
		mkdir -p usr/bin
		while read -r _line; do
			[[ -n $_line ]] || continue
			ln -s $_line
		done < "$srcdir/build/user_facing_tool_links.txt"
	fi
}
