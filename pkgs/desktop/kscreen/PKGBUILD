# Maintainer: BlankOS <builds@blankos.invalid>
# Based on BLFS 13.1 (systemd) and Arch Linux's kscreen

pkgname=kscreen
pkgver=6.7.4
pkgrel=1
pkgdesc="KDE screen management software"
arch=(x86_64)
url='https://kde.org/plasma-desktop/'
license=('LGPL-2.0-or-later')
depends=('glibc' 'kcmutils' 'kconfig' 'kcoreaddons' 'kcrash' 'ki18n' 'kimageformats' 'kirigami' 'kitemmodels' 'ksvg' 'kwindowsystem' 'layer-shell-qt' 'gcc-libs' 'libkscreen' 'libplasma' 'plasma5support' 'qt6-base' 'qt6-declarative' 'wayland')
makedepends=('cmake' 'ninja' 'extra-cmake-modules' 'qt6-tools' 'wayland-protocols')
source=("https://download.kde.org/stable/plasma/$pkgver/kscreen-$pkgver.tar.xz")
sha256sums=('8918c970ae363c7c1b8db76b21dc969162b5f41353fd88bde8667b46536eb8a6')

build() {
	cmake -S "kscreen-$pkgver" -B build -G Ninja -D CMAKE_INSTALL_PREFIX=/usr \
		-D CMAKE_BUILD_TYPE=Release -D CMAKE_INSTALL_LIBDIR=lib -D CMAKE_INSTALL_LIBEXECDIR=lib \
		-D CMAKE_SKIP_INSTALL_RPATH=ON -D BUILD_TESTING=OFF -W no-dev \
		-D BUILD_QT5=OFF
	ninja -C build
}

package() {
	DESTDIR="$pkgdir" ninja -C build install
}
