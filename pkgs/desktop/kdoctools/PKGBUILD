# Maintainer: BlankOS <builds@blankos.invalid>
# Based on BLFS 13.1 (systemd) and Arch Linux's kdoctools

pkgname=kdoctools
pkgver=6.29.0
pkgrel=1
pkgdesc="Documentation generation from docbook"
arch=(x86_64)
url='https://develop.kde.org/products/frameworks/'
license=('LGPL-2.0-only' 'LGPL-3.0-only')
depends=('docbook-xsl' 'glibc' 'karchive' 'gcc-libs' 'libxml2' 'libxslt' 'qt6-base' 'docbook-xml' 'perl-uri')
makedepends=('cmake' 'ninja' 'extra-cmake-modules' 'qt6-tools' 'ki18n')
source=("https://download.kde.org/stable/frameworks/${pkgver%.*}/kdoctools-$pkgver.tar.xz")
sha256sums=('1e1cb8bbf53e4f0482a916e1db9e202c8a8e8f4f2264dbcf98e837876ef83fae')

build() {
	cmake -S "kdoctools-$pkgver" -B build -G Ninja -D CMAKE_INSTALL_PREFIX=/usr \
		-D CMAKE_BUILD_TYPE=Release -D CMAKE_INSTALL_LIBDIR=lib -D CMAKE_INSTALL_LIBEXECDIR=lib \
		-D CMAKE_SKIP_INSTALL_RPATH=ON -D BUILD_TESTING=OFF -W no-dev \
		-D BUILD_QCH=OFF -D BUILD_PYTHON_BINDINGS=OFF
	ninja -C build
}

package() {
	DESTDIR="$pkgdir" ninja -C build install
}
