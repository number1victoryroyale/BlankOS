# Maintainer: BlankOS <builds@blankos.invalid>
# Based on BLFS 13.1 (systemd) and Arch Linux's powerdevil

pkgname=powerdevil
pkgver=6.7.4
pkgrel=1
pkgdesc="Manages the power consumption settings of a Plasma Shell"
arch=(x86_64)
url='https://kde.org/plasma-desktop/'
license=('LGPL-2.0-or-later')
depends=('glibc' 'kauth' 'kcmutils' 'kconfig' 'kcoreaddons' 'kcrash' 'kdbusaddons' 'kglobalaccel' 'ki18n' 'kidletime' 'kirigami' 'kitemmodels' 'knotifications' 'kpackage' 'kservice' 'kxmlgui' 'libkscreen' 'libplasma' 'gcc-libs' 'plasma-activities' 'plasma-workspace' 'qcoro' 'qt6-base' 'qt6-declarative' 'solid' 'systemd' 'wayland')
makedepends=('cmake' 'ninja' 'extra-cmake-modules' 'qt6-tools' 'kdoctools' 'plasma-wayland-protocols')
source=("https://download.kde.org/stable/plasma/$pkgver/powerdevil-$pkgver.tar.xz")
sha256sums=('cfd53172f168b5a80cba7ab85e7b929f6d7c7e0fa80ed0d48da140b5a7d698e3')

build() {
	cmake -S "powerdevil-$pkgver" -B build -G Ninja -D CMAKE_INSTALL_PREFIX=/usr \
		-D CMAKE_BUILD_TYPE=Release -D CMAKE_INSTALL_LIBDIR=lib -D CMAKE_INSTALL_LIBEXECDIR=lib \
		-D CMAKE_SKIP_INSTALL_RPATH=ON -D BUILD_TESTING=OFF -W no-dev \
		-D BUILD_QT5=OFF
	ninja -C build
}

package() {
	DESTDIR="$pkgdir" ninja -C build install
}
