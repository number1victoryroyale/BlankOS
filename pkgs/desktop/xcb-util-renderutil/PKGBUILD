# Maintainer: BlankOS <builds@blankos.invalid>
# Based on BLFS 13.1 (systemd)

pkgname=xcb-util-renderutil
pkgver=0.3.10
pkgrel=1
pkgdesc="Utility libraries for XC Binding - Convenience functions for the Render extension"
arch=(x86_64)
url='https://xcb.freedesktop.org/'
license=('MIT')
depends=('libxcb')
source=("https://xorg.freedesktop.org/archive/individual/lib/xcb-util-renderutil-$pkgver.tar.xz")
sha256sums=('3e15d4f0e22d8ddbfbb9f5d77db43eacd7a304029bf25a6166cc63caa96d04ba')

build() {
	cd "xcb-util-renderutil-$pkgver"
	./configure --prefix=/usr --sysconfdir=/etc --localstatedir=/var --disable-static
	make
}

package() {
	cd "xcb-util-renderutil-$pkgver"
	make DESTDIR="$pkgdir" install
}
