# Maintainer: BlankOS <builds@blankos.invalid>
# Based on BLFS 13.1 (systemd) and Arch Linux's kidletime

pkgname=kidletime
pkgver=6.29.0
pkgrel=1
pkgdesc="Monitoring user activity"
arch=(x86_64)
url='https://develop.kde.org/products/frameworks/'
license=('LGPL-2.0-only' 'LGPL-3.0-only')
depends=('glibc' 'gcc-libs' 'qt6-base')
makedepends=('cmake' 'ninja' 'extra-cmake-modules' 'qt6-tools' 'libxss' 'plasma-wayland-protocols' 'wayland-protocols')
source=("https://download.kde.org/stable/frameworks/${pkgver%.*}/kidletime-$pkgver.tar.xz")
sha256sums=('484002b1da719c72e6b6859422cf0d4351fbb61665aab04c3c2451edc320946b')

build() {
	cmake -S "kidletime-$pkgver" -B build -G Ninja -D CMAKE_INSTALL_PREFIX=/usr \
		-D CMAKE_BUILD_TYPE=Release -D CMAKE_INSTALL_LIBDIR=lib -D CMAKE_INSTALL_LIBEXECDIR=lib \
		-D CMAKE_SKIP_INSTALL_RPATH=ON -D BUILD_TESTING=OFF -W no-dev \
		-D BUILD_QCH=OFF -D BUILD_PYTHON_BINDINGS=OFF
	ninja -C build
}

package() {
	DESTDIR="$pkgdir" ninja -C build install
}
