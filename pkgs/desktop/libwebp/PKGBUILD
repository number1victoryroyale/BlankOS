# Maintainer: BlankOS <builds@blankos.invalid>
# Based on BLFS 13.1 (systemd)

pkgname=libwebp
pkgver=1.6.0
pkgrel=1
pkgdesc="WebP library and conversion tools"
arch=(x86_64)
url='https://developers.google.com/speed/webp/'
license=('BSD-3-Clause')
depends=('libpng' 'libjpeg-turbo' 'giflib' 'libtiff')
source=("https://storage.googleapis.com/downloads.webmproject.org/releases/webp/libwebp-$pkgver.tar.gz")
sha256sums=('e4ab7009bf0629fd11982d4c2aa83964cf244cffba7347ecd39019a9e38c4564')

build() {
	cd "libwebp-$pkgver"
	./configure --prefix=/usr --sysconfdir=/etc --localstatedir=/var --disable-static \
		--enable-libwebpmux --enable-libwebpdemux --enable-libwebpdecoder --enable-libwebpextras --enable-swap-16bit-csp
	make
}

package() {
	cd "libwebp-$pkgver"
	make DESTDIR="$pkgdir" install
}
