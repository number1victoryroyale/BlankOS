# Maintainer: BlankOS <builds@blankos.invalid>
# Based on BLFS 13.1 (systemd) and Arch Linux's qt6-5compat

pkgname=qt6-5compat
_qtver=6.11.2
pkgver=$_qtver
pkgrel=1
pkgdesc="Module that contains unsupported Qt 5 APIs"
arch=(x86_64)
url='https://www.qt.io'
license=('GPL-3.0-only' 'LGPL-3.0-only' 'LicenseRef-Qt-Commercial' 'Qt-GPL-exception-1.0')
depends=('glibc' 'icu' 'gcc-libs' 'qt6-base' 'qt6-shadertools')
makedepends=('cmake' 'ninja' 'qt6-declarative' 'qt6-shadertools')
source=("https://download.qt.io/official_releases/qt/${pkgver%.*}/$pkgver/submodules/qt5compat-everywhere-src-$pkgver.tar.xz")
sha256sums=('68c320fe3391096a9f2d870170edf1b67dac8af1d0e51c0c9e5343807f114287')

build() {
	cmake -S "qt5compat-everywhere-src-$pkgver" -B build -G Ninja -D CMAKE_MESSAGE_LOG_LEVEL=STATUS \
		-D CMAKE_BUILD_TYPE=Release -D QT_BUILD_TESTS=OFF -D QT_BUILD_EXAMPLES=OFF
	cmake --build build
}

package() {
	DESTDIR="$pkgdir" cmake --install build
	install -Dm644 "qt5compat-everywhere-src-$pkgver/LICENSES"/* -t "$pkgdir/usr/share/licenses/$pkgname"

	# Qt also writes these links relative to the prefix (/usr/usr/bin)
	rm -rf "$pkgdir/usr/usr"
	# user-facing tools (qmake6, qdbus6, ...) in /usr/bin
	if [[ -f $srcdir/build/user_facing_tool_links.txt ]]; then
		cd "$pkgdir"
		mkdir -p usr/bin
		while read -r _line; do
			[[ -n $_line ]] || continue
			ln -s $_line
		done < "$srcdir/build/user_facing_tool_links.txt"
	fi
}
