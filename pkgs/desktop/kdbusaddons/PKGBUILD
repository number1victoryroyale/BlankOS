# Maintainer: BlankOS <builds@blankos.invalid>
# Based on BLFS 13.1 (systemd) and Arch Linux's kdbusaddons

pkgname=kdbusaddons
pkgver=6.29.0
pkgrel=1
pkgdesc="Addons to QtDBus"
arch=(x86_64)
url='https://develop.kde.org/products/frameworks/'
license=('LGPL-2.0-only' 'LGPL-3.0-only')
depends=('glibc' 'gcc-libs' 'qt6-base')
makedepends=('cmake' 'ninja' 'extra-cmake-modules' 'qt6-tools')
source=("https://download.kde.org/stable/frameworks/${pkgver%.*}/kdbusaddons-$pkgver.tar.xz")
sha256sums=('a3d2de669bfad5de3f86cc8c6448a02f7567e4ad04aa6099ccfaa2df5f07e8f8')

build() {
	cmake -S "kdbusaddons-$pkgver" -B build -G Ninja -D CMAKE_INSTALL_PREFIX=/usr \
		-D CMAKE_BUILD_TYPE=Release -D CMAKE_INSTALL_LIBDIR=lib -D CMAKE_INSTALL_LIBEXECDIR=lib \
		-D CMAKE_SKIP_INSTALL_RPATH=ON -D BUILD_TESTING=OFF -W no-dev \
		-D BUILD_QCH=OFF -D BUILD_PYTHON_BINDINGS=OFF
	ninja -C build
}

package() {
	DESTDIR="$pkgdir" ninja -C build install
}
