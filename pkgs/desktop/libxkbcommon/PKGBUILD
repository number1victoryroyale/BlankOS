# Maintainer: BlankOS <builds@blankos.invalid>
# Based on BLFS 13.1 (systemd)

pkgname=libxkbcommon
pkgver=1.13.2
pkgrel=1
pkgdesc="Keymap handling library for toolkits and window systems"
arch=(x86_64)
url='https://xkbcommon.org/'
license=('MIT')
depends=('xkeyboard-config' 'libxml2' 'libxcb' 'wayland')
source=("libxkbcommon-$pkgver.tar.gz::https://github.com/lfs-book/libxkbcommon/archive/v$pkgver/libxkbcommon-$pkgver.tar.gz"
        "https://www.linuxfromscratch.org/patches/blfs/13.1/libxkbcommon-$pkgver-upstream_fix-1.patch")
sha256sums=('e5d5eff0ea09d82c44a96aec75c719b6969fdc602da82e6b1c9aa74cac5fd488'
            'd978cac5875fed73b7223866a1138718afeba58c1390a412affdcf2cd7744a34')

prepare() {
	cd "libxkbcommon-$pkgver"
	patch -Np1 -i "../libxkbcommon-$pkgver-upstream_fix-1.patch"
}

build() {
	meson setup build "libxkbcommon-$pkgver" --prefix=/usr --buildtype=release \
		-D enable-docs=false -D enable-wayland=true -D enable-x11=true -D enable-xkbregistry=true -D enable-bash-completion=false
	ninja -C build
}

package() {
	DESTDIR="$pkgdir" ninja -C build install
}
