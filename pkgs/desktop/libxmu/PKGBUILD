# Maintainer: BlankOS <builds@blankos.invalid>
# Based on BLFS 13.1 (systemd)

pkgname=libxmu
pkgver=1.3.1
pkgrel=1
pkgdesc="X11 miscellaneous micro-utility library"
arch=(x86_64)
url='https://xorg.freedesktop.org/'
license=('MIT')
depends=('libxt' 'libxext')
makedepends=('xorgproto' 'xorg-util-macros' 'xtrans')
source=("https://www.x.org/pub/individual/lib/libXmu-$pkgver.tar.xz")
sha256sums=('81a99e94c4501e81c427cbaa4a11748b584933e94b7a156830c3621256857bc4')

build() {
	cd "libXmu-$pkgver"
	./configure --prefix=/usr --sysconfdir=/etc --localstatedir=/var --disable-static
	make
}

package() {
	cd "libXmu-$pkgver"
	make DESTDIR="$pkgdir" install
}
