# Maintainer: BlankOS <builds@blankos.invalid>
# Based on BLFS 13.1 (systemd) and Arch Linux's kquickimageeditor

pkgname=kquickimageeditor
pkgver=0.6.2.1
pkgrel=1
pkgdesc="Simple image editor for QtQuick applications"
arch=(x86_64)
url='https://invent.kde.org/libraries/kquickimageeditor'
license=('LGPL-2.1-or-later')
depends=('qt6-base' 'qt6-declarative' 'kirigami' 'kconfig' 'ki18n' 'opencv')
makedepends=('cmake' 'ninja' 'extra-cmake-modules' 'qt6-tools')
source=("https://download.kde.org/stable/kquickimageeditor/kquickimageeditor-$pkgver.tar.xz")
sha256sums=('6d37a479463dcd16e4746d8b43d4adb05640e8b49056baabc82c865e2e1a4c85')

build() {
	cmake -S "kquickimageeditor-$pkgver" -B build -G Ninja -D CMAKE_INSTALL_PREFIX=/usr \
		-D CMAKE_BUILD_TYPE=Release -D CMAKE_INSTALL_LIBDIR=lib -D CMAKE_INSTALL_LIBEXECDIR=lib \
		-D CMAKE_SKIP_INSTALL_RPATH=ON -D BUILD_TESTING=OFF -W no-dev \
		-D BUILD_WITH_QT6=ON
	ninja -C build
}

package() {
	DESTDIR="$pkgdir" ninja -C build install
}
