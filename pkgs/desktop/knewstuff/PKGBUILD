# Maintainer: BlankOS <builds@blankos.invalid>
# Based on BLFS 13.1 (systemd) and Arch Linux's knewstuff

pkgname=knewstuff
pkgver=6.29.0
pkgrel=1
pkgdesc="Support for downloading application assets from the network"
arch=(x86_64)
url='https://develop.kde.org/products/frameworks/'
license=('LGPL-2.0-only' 'LGPL-3.0-only')
depends=('attica' 'glibc' 'karchive' 'kcmutils' 'kconfig' 'kcoreaddons' 'ki18n' 'kirigami' 'kpackage' 'kwidgetsaddons' 'gcc-libs' 'qt6-base' 'qt6-declarative' 'syndication')
makedepends=('cmake' 'ninja' 'extra-cmake-modules' 'qt6-tools')
source=("https://download.kde.org/stable/frameworks/${pkgver%.*}/knewstuff-$pkgver.tar.xz")
sha256sums=('30e59a8f2c592177b255034c6320da9f3211377e97a8fdbe16be8bef3a356567')

build() {
	cmake -S "knewstuff-$pkgver" -B build -G Ninja -D CMAKE_INSTALL_PREFIX=/usr \
		-D CMAKE_BUILD_TYPE=Release -D CMAKE_INSTALL_LIBDIR=lib -D CMAKE_INSTALL_LIBEXECDIR=lib \
		-D CMAKE_SKIP_INSTALL_RPATH=ON -D BUILD_TESTING=OFF -W no-dev \
		-D BUILD_QCH=OFF -D BUILD_PYTHON_BINDINGS=OFF
	ninja -C build
}

package() {
	DESTDIR="$pkgdir" ninja -C build install
}
