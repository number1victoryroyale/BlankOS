# Maintainer: BlankOS <builds@blankos.invalid>
# Based on BLFS 13.1 (systemd)

pkgname=libqrencode
pkgver=4.1.1
pkgrel=1
pkgdesc="C library for encoding data in a QR Code symbol"
arch=(x86_64)
url='https://fukuchi.org/works/qrencode/'
license=('LGPL-2.1-or-later')
depends=('glibc')
source=("libqrencode-$pkgver.tar.gz::https://github.com/fukuchi/libqrencode/archive/v$pkgver/libqrencode-$pkgver.tar.gz")
sha256sums=('5385bc1b8c2f20f3b91d258bf8ccc8cf62023935df2d2676b5b67049f31a049c')

build() {
	cmake -S "libqrencode-$pkgver" -B build -G Ninja -D CMAKE_INSTALL_PREFIX=/usr \
		-D CMAKE_BUILD_TYPE=Release -D CMAKE_INSTALL_LIBDIR=lib -D CMAKE_INSTALL_LIBEXECDIR=lib \
		-D CMAKE_SKIP_INSTALL_RPATH=ON -D BUILD_TESTING=OFF -W no-dev \
		-D BUILD_SHARED_LIBS=ON -D WITH_TOOLS=OFF -D CMAKE_POLICY_VERSION_MINIMUM=3.5
	ninja -C build
}

package() {
	DESTDIR="$pkgdir" ninja -C build install
}
