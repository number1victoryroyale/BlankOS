# Maintainer: BlankOS <builds@blankos.invalid>
# Based on BLFS 13.1 (systemd) and Arch Linux's kiconthemes

pkgname=kiconthemes
pkgver=6.29.0
pkgrel=1
pkgdesc="Support for icon themes"
arch=(x86_64)
url='https://develop.kde.org/products/frameworks/'
license=('LGPL-2.0-only' 'LGPL-3.0-only')
depends=('breeze-icons' 'glibc' 'karchive' 'kcolorscheme' 'kconfig' 'ki18n' 'kwidgetsaddons' 'gcc-libs' 'qt6-base' 'qt6-svg')
makedepends=('cmake' 'ninja' 'extra-cmake-modules' 'qt6-tools')
source=("https://download.kde.org/stable/frameworks/${pkgver%.*}/kiconthemes-$pkgver.tar.xz")
sha256sums=('233de4cd2fef5b7b4ce1e317196407d25300b767614a93e160b45ac34710223d')

build() {
	cmake -S "kiconthemes-$pkgver" -B build -G Ninja -D CMAKE_INSTALL_PREFIX=/usr \
		-D CMAKE_BUILD_TYPE=Release -D CMAKE_INSTALL_LIBDIR=lib -D CMAKE_INSTALL_LIBEXECDIR=lib \
		-D CMAKE_SKIP_INSTALL_RPATH=ON -D BUILD_TESTING=OFF -W no-dev \
		-D BUILD_QCH=OFF -D BUILD_PYTHON_BINDINGS=OFF
	ninja -C build
}

package() {
	DESTDIR="$pkgdir" ninja -C build install
}
