# Maintainer: BlankOS <builds@blankos.invalid>
# Based on BLFS 13.1 (systemd) and Arch Linux's bluez-qt

pkgname=bluez-qt
pkgver=6.29.0
pkgrel=1
pkgdesc="Qt wrapper for Bluez 5 DBus API"
arch=(x86_64)
url='https://develop.kde.org/products/frameworks/'
license=('LGPL-2.0-only' 'LGPL-3.0-only')
depends=('bluez' 'glibc' 'gcc-libs' 'qt6-base')
makedepends=('cmake' 'ninja' 'extra-cmake-modules' 'qt6-tools' 'qt6-declarative')
source=("https://download.kde.org/stable/frameworks/${pkgver%.*}/bluez-qt-$pkgver.tar.xz")
sha256sums=('15e2ae85d0e3e205cd17c3c5f079d2263abc4a341fbf223b2561510f69382a2b')

build() {
	cmake -S "bluez-qt-$pkgver" -B build -G Ninja -D CMAKE_INSTALL_PREFIX=/usr \
		-D CMAKE_BUILD_TYPE=Release -D CMAKE_INSTALL_LIBDIR=lib -D CMAKE_INSTALL_LIBEXECDIR=lib \
		-D CMAKE_SKIP_INSTALL_RPATH=ON -D BUILD_TESTING=OFF -W no-dev \
		-D BUILD_QCH=OFF -D BUILD_PYTHON_BINDINGS=OFF -D UDEV_RULES_INSTALL_DIR=/usr/lib/udev/rules.d
	ninja -C build
}

package() {
	DESTDIR="$pkgdir" ninja -C build install
}
