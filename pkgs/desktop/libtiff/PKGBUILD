# Maintainer: BlankOS <builds@blankos.invalid>
# Based on BLFS 13.1 (systemd)

pkgname=libtiff
pkgver=4.7.2
pkgrel=1
pkgdesc="Library for manipulation of TIFF images"
arch=(x86_64)
url='https://libtiff.gitlab.io/libtiff/'
license=('libtiff')
depends=('libjpeg-turbo' 'zlib' 'xz' 'zstd')
source=("https://download.osgeo.org/libtiff/tiff-$pkgver.tar.gz")
sha256sums=('672bd7d10aee4606171afb864f3570b83340f6a33e2c186dc0512f7145ffdf6a')

build() {
	cmake -S "tiff-$pkgver" -B build -G Ninja -D CMAKE_INSTALL_PREFIX=/usr \
		-D CMAKE_BUILD_TYPE=Release -D CMAKE_INSTALL_LIBDIR=lib -D CMAKE_INSTALL_LIBEXECDIR=lib \
		-D CMAKE_SKIP_INSTALL_RPATH=ON -D BUILD_TESTING=OFF -W no-dev \
		-D tiff-docs=OFF -D tiff-tests=OFF -D tiff-contrib=OFF -D tiff-tools=ON
	ninja -C build
}

package() {
	DESTDIR="$pkgdir" ninja -C build install
}
