# Maintainer: BlankOS <builds@blankos.invalid>
# Based on BLFS 13.1 (systemd) and Arch Linux's bluedevil

pkgname=bluedevil
pkgver=6.7.4
pkgrel=1
pkgdesc="Integrate the Bluetooth technology within KDE workspace and applications"
arch=(x86_64)
url='https://kde.org/plasma-desktop/'
license=('GPL-2.0-or-later')
depends=('bluez-qt' 'glibc' 'kcmutils' 'kconfig' 'kcoreaddons' 'kdbusaddons' 'kdeclarative' 'ki18n' 'kio' 'kirigami' 'kjobwidgets' 'knotifications' 'kservice' 'ksvg' 'kwidgetsaddons' 'kwindowsystem' 'libplasma' 'gcc-libs' 'qt6-base' 'qt6-declarative')
makedepends=('cmake' 'ninja' 'extra-cmake-modules' 'qt6-tools' 'kdoctools')
source=("https://download.kde.org/stable/plasma/$pkgver/bluedevil-$pkgver.tar.xz")
sha256sums=('8a3bb7d3005b0a01af171bdb41bececd5848de75c4a4d68d399a49c517791652')

build() {
	cmake -S "bluedevil-$pkgver" -B build -G Ninja -D CMAKE_INSTALL_PREFIX=/usr \
		-D CMAKE_BUILD_TYPE=Release -D CMAKE_INSTALL_LIBDIR=lib -D CMAKE_INSTALL_LIBEXECDIR=lib \
		-D CMAKE_SKIP_INSTALL_RPATH=ON -D BUILD_TESTING=OFF -W no-dev \
		-D BUILD_QT5=OFF
	ninja -C build
}

package() {
	DESTDIR="$pkgdir" ninja -C build install
}
