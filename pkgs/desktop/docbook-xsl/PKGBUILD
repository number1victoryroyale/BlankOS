# Maintainer: BlankOS <builds@blankos.invalid>
# Based on BLFS 13.1 (systemd)

pkgname=docbook-xsl
pkgver=1.79.2
pkgrel=1
pkgdesc="XML stylesheets for Docbook-xml transformations"
arch=(any)
url='https://github.com/docbook/xslt10-stylesheets'
license=('MIT')
depends=('libxml2' 'libxslt' 'docbook-xml')
install=docbook-xsl.install
source=("https://github.com/docbook/xslt10-stylesheets/releases/download/release/$pkgver/docbook-xsl-nons-$pkgver.tar.bz2"
        "https://www.linuxfromscratch.org/patches/blfs/13.1/docbook-xsl-nons-1.79.2-stack_fix-1.patch")
sha256sums=('ee8b9eca0b7a8f89075832a2da7534bce8c5478fc8fc2676f512d5d87d832102'
            'a92c39715c54949ba9369add1809527b8f155b7e2a2b2e30cb4b39ee715f2e30')

prepare() {
	cd "docbook-xsl-nons-$pkgver"
	patch -Np1 -i ../docbook-xsl-nons-1.79.2-stack_fix-1.patch
}

package() {
	cd "docbook-xsl-nons-$pkgver"
	_d=$pkgdir/usr/share/xml/docbook/xsl-stylesheets-nons-$pkgver
	install -d "$_d"
	cp -R VERSION assembly common eclipse epub epub3 extensions fo highlighting html htmlhelp images javahelp \
		lib manpages params profiling roundtrip slides template tests tools webhelp website xhtml xhtml-1_1 xhtml5 "$_d"
	ln -s VERSION "$_d/VERSION.xsl"
	install -Dm644 COPYING "$pkgdir/usr/share/licenses/$pkgname/COPYING"
}
