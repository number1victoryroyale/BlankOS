# Maintainer: BlankOS <builds@blankos.invalid>
# Based on BLFS 13.1 (systemd) and Arch Linux's ark

pkgname=ark
pkgver=26.04.3
pkgrel=1
pkgdesc="Archiving Tool"
arch=(x86_64)
url='https://apps.kde.org/ark/'
license=('GPL-2.0-or-later')
depends=('breeze-icons' 'glibc' 'kcolorscheme' 'kcompletion' 'kconfig' 'kconfigwidgets' 'kcoreaddons' 'kcrash' 'kdbusaddons' 'kfilemetadata' 'ki18n' 'kio' 'kjobwidgets' 'kparts' 'kpty' 'kservice' 'kwidgetsaddons' 'kwindowsystem' 'kxmlgui' 'libarchive' 'gcc-libs' 'qt6-base' 'zlib')
makedepends=('cmake' 'ninja' 'extra-cmake-modules' 'qt6-tools' 'kdoctools')
source=("https://download.kde.org/stable/release-service/$pkgver/src/ark-$pkgver.tar.xz")
sha256sums=('8018fec69668aac35e5ab7ce4e51ce04de6ab7f56a3996322b016f41c31d5a01')

build() {
	cmake -S "ark-$pkgver" -B build -G Ninja -D CMAKE_INSTALL_PREFIX=/usr \
		-D CMAKE_BUILD_TYPE=Release -D CMAKE_INSTALL_LIBDIR=lib -D CMAKE_INSTALL_LIBEXECDIR=lib \
		-D CMAKE_SKIP_INSTALL_RPATH=ON -D BUILD_TESTING=OFF -W no-dev \
		-D BUILD_QCH=OFF
	ninja -C build
}

package() {
	DESTDIR="$pkgdir" ninja -C build install
}
