# Maintainer: BlankOS <builds@blankos.invalid>
# Based on BLFS 13.1 (systemd) and Arch Linux's qt6-svg

pkgname=qt6-svg
_qtver=6.11.2
pkgver=$_qtver
pkgrel=1
pkgdesc="Classes for displaying the contents of SVG files"
arch=(x86_64)
url='https://www.qt.io'
license=('GPL-3.0-only' 'LGPL-3.0-only' 'LicenseRef-Qt-Commercial' 'Qt-GPL-exception-1.0')
depends=('glibc' 'gcc-libs' 'qt6-base' 'zlib')
makedepends=('cmake' 'ninja')
source=("https://download.qt.io/official_releases/qt/${pkgver%.*}/$pkgver/submodules/qtsvg-everywhere-src-$pkgver.tar.xz")
sha256sums=('d594337feca84c26fb67fe87b85e6a5c12fda404b611d905f9d138210c311876')

build() {
	cmake -S "qtsvg-everywhere-src-$pkgver" -B build -G Ninja -D CMAKE_MESSAGE_LOG_LEVEL=STATUS \
		-D CMAKE_BUILD_TYPE=Release -D QT_BUILD_TESTS=OFF -D QT_BUILD_EXAMPLES=OFF
	cmake --build build
}

package() {
	DESTDIR="$pkgdir" cmake --install build
	install -Dm644 "qtsvg-everywhere-src-$pkgver/LICENSES"/* -t "$pkgdir/usr/share/licenses/$pkgname"

	# user-facing tools (qmake6, qdbus6, ...) in /usr/bin
	if [[ -f $srcdir/build/user_facing_tool_links.txt ]]; then
		cd "$pkgdir"
		mkdir -p usr/bin
		while read -r _line; do
			ln -s $_line
		done < "$srcdir/build/user_facing_tool_links.txt"
	fi
}
