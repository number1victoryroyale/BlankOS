# Maintainer: BlankOS <builds@blankos.invalid>
# Based on BLFS 13.1 (systemd) and Arch Linux's ksystemstats

pkgname=ksystemstats
pkgver=6.7.4
pkgrel=1
pkgdesc="A plugin based system monitoring daemon"
arch=(x86_64)
url='https://kde.org/plasma-desktop/'
license=('LGPL-2.0-or-later')
depends=('glibc' 'kcoreaddons' 'kcrash' 'ki18n' 'kio' 'libksysguard' 'gcc-libs' 'qt6-base' 'solid')
makedepends=('cmake' 'ninja' 'extra-cmake-modules' 'qt6-tools' 'libnl' 'networkmanager-qt')
source=("https://download.kde.org/stable/plasma/$pkgver/ksystemstats-$pkgver.tar.xz")
sha256sums=('919f2436ff8da8ff6ea7d2c007bdaf6bcd8a2f096d0544ba450124ffac56dc94')

build() {
	cmake -S "ksystemstats-$pkgver" -B build -G Ninja -D CMAKE_INSTALL_PREFIX=/usr \
		-D CMAKE_BUILD_TYPE=Release -D CMAKE_INSTALL_LIBDIR=lib -D CMAKE_INSTALL_LIBEXECDIR=lib \
		-D CMAKE_SKIP_INSTALL_RPATH=ON -D BUILD_TESTING=OFF -W no-dev \
		-D BUILD_QT5=OFF
	ninja -C build
}

package() {
	DESTDIR="$pkgdir" ninja -C build install
}
