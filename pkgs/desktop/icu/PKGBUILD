# Maintainer: BlankOS <builds@blankos.invalid>
# Based on BLFS 13.1 (systemd)

pkgname=icu
pkgver=78.3
pkgrel=1
pkgdesc="International Components for Unicode library"
arch=(x86_64)
url='https://icu.unicode.org'
license=('Unicode-3.0')
depends=('gcc-libs')
source=("https://github.com/unicode-org/icu/releases/download/release-78.3/icu4c-78.3-sources.tgz")
sha256sums=('3a2e7a47604ba702f345878308e6fefeca612ee895cf4a5f222e7955fabfe0c0')

build() {
	cd icu/source
	./configure --prefix=/usr --disable-static --disable-tests --disable-samples
	make
}

package() {
	cd icu/source
	make DESTDIR="$pkgdir" install
}
