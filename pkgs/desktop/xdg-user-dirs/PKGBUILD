# Maintainer: BlankOS <builds@blankos.invalid>
# Based on BLFS 13.1 (systemd)

pkgname=xdg-user-dirs
pkgver=0.20
pkgrel=1
pkgdesc="Manage user directories like ~/Desktop and ~/Music"
arch=(x86_64)
url='https://www.freedesktop.org/wiki/Software/xdg-user-dirs'
license=('GPL-2.0-or-later')
depends=('glibc')
makedepends=('meson' 'ninja' 'gettext')
source=("https://gitlab.freedesktop.org/xdg/xdg-user-dirs/-/archive/v$pkgver/xdg-user-dirs-v$pkgver.tar.gz")
sha256sums=('988d3f3274cb2b69796ace22ddbb0abfc2c0157fff65258045f055cfba024d6e')

build() {
	meson setup build "xdg-user-dirs-v$pkgver" --prefix=/usr --buildtype=release \
		-D docs=false
	ninja -C build
}

package() {
	DESTDIR="$pkgdir" ninja -C build install
}
