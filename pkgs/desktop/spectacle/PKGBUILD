# Maintainer: BlankOS <builds@blankos.invalid>
# Based on BLFS 13.1 (systemd) and Arch Linux's spectacle

pkgname=spectacle
pkgver=6.7.4
pkgrel=1
pkgdesc="KDE screenshot capture utility"
arch=(x86_64)
url='https://kde.org/plasma-desktop/'
license=('GPL-2.0-or-later')
depends=('opencv' 'tesseract' 'glibc' 'kconfig' 'kconfigwidgets' 'kcoreaddons' 'kcrash' 'kdbusaddons' 'kglobalaccel' 'kguiaddons' 'ki18n' 'kio' 'kirigami' 'kjobwidgets' 'knotifications' 'kpipewire' 'kservice' 'kstatusnotifieritem' 'kwidgetsaddons' 'kwindowsystem' 'kxmlgui' 'layer-shell-qt' 'gcc-libs' 'libxcb' 'prison' 'purpose' 'qt6-base' 'qt6-declarative' 'qt6-imageformats' 'qt6-multimedia' 'wayland' 'xcb-util' 'xcb-util-cursor' 'xcb-util-image' 'kquickimageeditor')
makedepends=('cmake' 'ninja' 'extra-cmake-modules' 'qt6-tools' 'kdoctools' 'plasma-wayland-protocols')
source=("https://download.kde.org/stable/plasma/$pkgver/spectacle-$pkgver.tar.xz")
sha256sums=('5c61ffd9b37ca6384b754d44a051c8f979ab77984f92e7ddf3a1c15156d65665')

build() {
	cmake -S "spectacle-$pkgver" -B build -G Ninja -D CMAKE_INSTALL_PREFIX=/usr \
		-D CMAKE_BUILD_TYPE=Release -D CMAKE_INSTALL_LIBDIR=lib -D CMAKE_INSTALL_LIBEXECDIR=lib \
		-D CMAKE_SKIP_INSTALL_RPATH=ON -D BUILD_TESTING=OFF -W no-dev \
		-D BUILD_QT5=OFF
	ninja -C build
}

package() {
	DESTDIR="$pkgdir" ninja -C build install
}
