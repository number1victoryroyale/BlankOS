# Maintainer: BlankOS <builds@blankos.invalid>
# Based on BLFS 13.1 (systemd)

pkgname=libcanberra
pkgver=0.30
pkgrel=1
pkgdesc="A small and lightweight implementation of the XDG Sound Theme Specification"
arch=(x86_64)
url='https://0pointer.de/lennart/projects/libcanberra/'
license=('LGPL-2.1-or-later')
depends=('alsa-lib' 'libpulse' 'libvorbis' 'systemd')
source=("https://0pointer.de/lennart/projects/libcanberra/libcanberra-$pkgver.tar.xz"
        "https://www.linuxfromscratch.org/patches/blfs/13.1/libcanberra-$pkgver-wayland-1.patch")
sha256sums=('c2b671e67e0c288a69fc33dc1b6f1b534d07882c2aceed37004bf48c601afa72'
            'e48ce8f952c2b71e38866b95aa21e02437924ed6f9c4409b64e8e4cb392b9013')

prepare() {
	cd "libcanberra-$pkgver"
	patch -Np1 -i "../libcanberra-$pkgver-wayland-1.patch"
}

build() {
	cd "libcanberra-$pkgver"
	./configure --prefix=/usr --sysconfdir=/etc --localstatedir=/var --disable-static \
		--disable-oss --disable-gtk --disable-gtk3 --disable-gstreamer --disable-lynx --disable-tdb --disable-udev --with-systemdsystemunitdir=no
	make
}

package() {
	cd "libcanberra-$pkgver"
	make DESTDIR="$pkgdir" install
}
