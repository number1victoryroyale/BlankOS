# Maintainer: BlankOS <builds@blankos.invalid>
# Based on BLFS 13.1 (systemd) and Arch Linux's kpeople

pkgname=kpeople
pkgver=6.29.0
pkgrel=1
pkgdesc="A library that provides access to all contacts and the people who hold them"
arch=(x86_64)
url='https://develop.kde.org/products/frameworks/'
license=('LGPL-2.0-only' 'LGPL-3.0-only')
depends=('glibc' 'kcontacts' 'kcoreaddons' 'ki18n' 'kitemviews' 'kwidgetsaddons' 'gcc-libs' 'qt6-base')
makedepends=('cmake' 'ninja' 'extra-cmake-modules' 'qt6-tools' 'qt6-declarative')
source=("https://download.kde.org/stable/frameworks/${pkgver%.*}/kpeople-$pkgver.tar.xz")
sha256sums=('cb8900532f6c1ba6a4711b3d98e4d2b1c23bf2deb5588262f35554344fe574ca')

build() {
	cmake -S "kpeople-$pkgver" -B build -G Ninja -D CMAKE_INSTALL_PREFIX=/usr \
		-D CMAKE_BUILD_TYPE=Release -D CMAKE_INSTALL_LIBDIR=lib -D CMAKE_INSTALL_LIBEXECDIR=lib \
		-D CMAKE_SKIP_INSTALL_RPATH=ON -D BUILD_TESTING=OFF -W no-dev \
		-D BUILD_QCH=OFF -D BUILD_PYTHON_BINDINGS=OFF
	ninja -C build
}

package() {
	DESTDIR="$pkgdir" ninja -C build install
}
