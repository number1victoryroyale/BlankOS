# Maintainer: BlankOS <builds@blankos.invalid>
# Based on BLFS 13.1 (systemd) and Arch Linux's qca-qt6

pkgname=qca-qt6
pkgver=2.3.10
pkgrel=1
pkgdesc="Qt Cryptographic Architecture"
arch=(x86_64)
url='https://userbase.kde.org/QCA'
license=('LGPL-2.1-or-later')
depends=('ca-certificates' 'glibc' 'gcc-libs' 'qt6-5compat' 'qt6-base' 'openssl' 'gnupg')
makedepends=('cmake' 'ninja' 'extra-cmake-modules' 'qt6-tools' 'libgcrypt')
source=("https://download.kde.org/stable/qca/$pkgver/qca-$pkgver.tar.xz"
        "https://www.linuxfromscratch.org/patches/blfs/13.1/qca-2.3.10-openssl4_fixes-1.patch")
sha256sums=('1c5b722da93d559365719226bb121c726ec3c0dc4c67dea34f1e50e4e0d14a02'
            '0c5c9d69f30db77d7d786e48e553dc569afc33c24b5fa856778315728f11828b')

prepare() {
	cd "qca-$pkgver"
	patch -Np1 -i ../qca-2.3.10-openssl4_fixes-1.patch
	sed -i 's@cert.pem@certs/ca-certificates.crt@' CMakeLists.txt
}

build() {
	cmake -S "qca-$pkgver" -B build -G Ninja -D CMAKE_INSTALL_PREFIX=/usr \
		-D CMAKE_BUILD_TYPE=Release -D CMAKE_INSTALL_LIBDIR=lib -D CMAKE_INSTALL_LIBEXECDIR=lib \
		-D CMAKE_SKIP_INSTALL_RPATH=ON -D BUILD_TESTING=OFF -W no-dev \
		-D QT6=ON -D BUILD_TESTS=OFF -D QCA_INSTALL_IN_QT_PREFIX=ON \
		-D QCA_FEATURE_INSTALL_DIR=/usr/lib/qt6/mkspecs/features -D QCA_MAN_INSTALL_DIR=/usr/share/man \
		-D WITH_botan_PLUGIN=no -D WITH_pkcs11_PLUGIN=no -D WITH_nss_PLUGIN=no -D WITH_cyrus-sasl_PLUGIN=no
	ninja -C build
}

package() {
	DESTDIR="$pkgdir" ninja -C build install
}
