#!/bin/bash
# blankos-wine-dx: put DXVK (Direct3D 8-11) and VKD3D-Proton (Direct3D 12)
# into a Wine prefix, or take them out again.
#
#   blankos-wine-dx install   [PREFIX]   (default: $WINEPREFIX or ~/.wine)
#   blankos-wine-dx uninstall [PREFIX]
set -euo pipefail

action=${1:-}
export WINEPREFIX=${2:-${WINEPREFIX:-$HOME/.wine}}
dxvk=/usr/share/dxvk
vkd3d=/usr/share/vkd3d-proton
dxvk_dlls=(d3d8 d3d9 d3d10core d3d11 dxgi)
vkd3d_dlls=(d3d12 d3d12core)

case $action in
	install|uninstall) ;;
	*) echo "usage: blankos-wine-dx install|uninstall [PREFIX]" >&2; exit 2 ;;
esac

# a new prefix is created on first use
[[ -d $WINEPREFIX/drive_c/windows ]] || wineboot -u
sys64=$WINEPREFIX/drive_c/windows/system32
sys32=$WINEPREFIX/drive_c/windows/syswow64

override() {
	if [[ $action == install ]]; then
		wine reg add 'HKEY_CURRENT_USER\Software\Wine\DllOverrides' /v "$1" /d native /f > /dev/null
	else
		wine reg delete 'HKEY_CURRENT_USER\Software\Wine\DllOverrides' /v "$1" /f > /dev/null 2>&1 || true
	fi
}

copy() { # copy DIR64 DIR32 DLL
	if [[ $action == install ]]; then
		[[ -f $1/$3.dll ]] && install -m644 "$1/$3.dll" "$sys64/$3.dll"
		[[ -f $2/$3.dll ]] && install -m644 "$2/$3.dll" "$sys32/$3.dll"
	fi
	override "$3"
}

for d in "${dxvk_dlls[@]}"; do copy "$dxvk/x64" "$dxvk/x32" "$d"; done
for d in "${vkd3d_dlls[@]}"; do copy "$vkd3d/x64" "$vkd3d/x86" "$d"; done
# uninstall: let Wine restore its own builtin DLLs
[[ $action == uninstall ]] && wineboot -u
echo "DXVK and VKD3D-Proton ${action}ed in $WINEPREFIX"
