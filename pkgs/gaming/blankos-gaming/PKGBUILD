# Maintainer: BlankOS <builds@blankos.invalid>
#
# The BlankOS gaming layer: Wine (with DXVK and VKD3D-Proton), game
# performance tools, controller support, NTSYNC and the Game Hub, which
# installs Steam, Sober (Roblox) and other launchers from Flathub.

pkgname=blankos-gaming
pkgver=0.5.0
pkgrel=1
pkgdesc="BlankOS gaming layer: Wine, DXVK, VKD3D-Proton, GameMode, MangoHud, controllers and the Game Hub"
arch=(any)
url='https://github.com/number1victoryroyale/BlankOS'
license=('GPL-3.0-or-later')
depends=('blankos-desktop'
         'wine' 'winetricks' 'dxvk-bin' 'vkd3d-proton-bin' 'cabextract' '7zip'
         'gamemode' 'mangohud'
         'game-devices-udev' 'xpadneo' 'sdl2-compat'
         'blankos-game-hub')
source=("ntsync.conf" "70-ntsync.rules" "blankos-wine-dx")
sha256sums=('c19771ae86e7df179f6b2f4a2837d3f0cbbbba7b32baef41a3c27120c760d78f'
            '945d8d1fff8f9eb9eadbf86b4c48b8dc89c8ee3139a53043dabecb594870f1c2'
            'b8593293d2858470aeb4358fd1903bb2f602281d048f8b61706d4feb48170fb3')

package() {
	# NTSYNC: Wine's fast synchronization driver, loaded at boot and
	# usable by every user
	install -Dm644 ntsync.conf "$pkgdir/usr/lib/modules-load.d/ntsync.conf"
	install -Dm644 70-ntsync.rules "$pkgdir/usr/lib/udev/rules.d/70-ntsync.rules"
	install -Dm755 blankos-wine-dx "$pkgdir/usr/bin/blankos-wine-dx"
}
