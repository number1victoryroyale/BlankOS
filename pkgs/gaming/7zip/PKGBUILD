# Maintainer: BlankOS <builds@blankos.invalid>
# Based on BLFS 13.1 (systemd)

pkgname=7zip
pkgver=26.02
pkgrel=1
pkgdesc="File archiver with a high compression ratio (7z, zip, rar extraction and more)"
arch=(x86_64)
url='https://7-zip.org/'
license=('LGPL-2.1-or-later' 'BSD-3-Clause' 'LicenseRef-UnRAR')
depends=('gcc-libs')
provides=('p7zip')
source=("https://github.com/ip7z/7zip/archive/$pkgver/7zip-$pkgver.tar.gz")
sha256sums=('7e5600ad0b21918bc41803bd84d0c2967e097fb7fbaa2e7aeb90beeb1121e54b')

prepare() {
	cd "7zip-$pkgver"
	sed -i 's/-Werror //g' CPP/7zip/7zip_gcc.mak
}

build() {
	cd "7zip-$pkgver"
	local i
	for i in Bundles/Alone Bundles/Alone7z Bundles/Format7zF Bundles/SFXCon UI/Console; do
		make -C "CPP/7zip/$i" -f ../../cmpl_gcc.mak
	done
}

package() {
	cd "7zip-$pkgver"
	install -Dm755 CPP/7zip/Bundles/Alone/b/g/7za CPP/7zip/Bundles/Alone7z/b/g/7zr \
		CPP/7zip/Bundles/Format7zF/b/g/7z.so CPP/7zip/UI/Console/b/g/7z -t "$pkgdir/usr/lib/7zip/"
	install -m755 CPP/7zip/Bundles/SFXCon/b/g/7zCon "$pkgdir/usr/lib/7zip/7zCon.sfx"
	install -d "$pkgdir/usr/bin"
	local i
	for i in 7z 7za 7zr; do
		printf '#!/bin/sh\nexec /usr/lib/7zip/%s "$@"\n' "$i" > "$pkgdir/usr/bin/$i"
		chmod 755 "$pkgdir/usr/bin/$i"
	done
	install -Dm644 DOC/License.txt "$pkgdir/usr/share/licenses/$pkgname/License.txt"
}
