# Maintainer: BlankOS <builds@blankos.invalid>
# Based on Arch Linux's cabextract (winetricks needs it for Microsoft runtimes)

pkgname=cabextract
pkgver=1.11
pkgrel=1
pkgdesc="A program to extract Microsoft cabinet (.CAB) files"
arch=(x86_64)
url='https://www.cabextract.org.uk/'
license=('GPL-2.0-or-later')
depends=('glibc')
source=("https://www.cabextract.org.uk/cabextract-$pkgver.tar.gz")
sha256sums=('b5546db1155e4c718ff3d4b278573604f30dd64c3c5bfd4657cd089b823a3ac6')

build() {
	cd "cabextract-$pkgver"
	./configure --prefix=/usr --mandir=/usr/share/man
	make
}

package() {
	cd "cabextract-$pkgver"
	make DESTDIR="$pkgdir" install
}
