prepare() {
	cd "gamescope-$pkgver"
	# the version comes from git describe; this is a tarball
	sed -i "s/^vcs_tag = run_command.*/vcs_tag = '$pkgver'/" src/meson.build
	local d
	for d in subprojects/{wlroots,libliftoff,libdisplay-info,vkroots,glm,stb} src/reshade thirdparty/SPIRV-Headers; do
		rm -rf "$d"
	done
	mv "$srcdir/wlroots-$_wlroots" subprojects/wlroots
	mv "$srcdir/libliftoff-$_liftoff" subprojects/libliftoff
	mv "$srcdir/libdisplay-info-$_displayinfo" subprojects/libdisplay-info
	mv "$srcdir/vkroots-$_vkroots" subprojects/vkroots
	mv "$srcdir/reshade-$_reshade" src/reshade
	mv "$srcdir/SPIRV-Headers-$_spirvheaders" thirdparty/SPIRV-Headers
	# the glm and stb wraps: their sources plus gamescope's meson.build for them
	mv "$srcdir/glm-$_glm" subprojects/glm
	mv "$srcdir/stb-$_stb" subprojects/stb
	cp subprojects/packagefiles/glm/* subprojects/glm/
	cp subprojects/packagefiles/stb/* subprojects/stb/
}

build() {
	meson setup build "gamescope-$pkgver" --prefix=/usr --buildtype=release --wrap-mode=nodownload \
		-D force_fallback_for=glm,stb,libdisplay-info,libliftoff,vkroots,wlroots \
		-D pipewire=enabled -D drm_backend=enabled -D sdl2_backend=enabled -D rt_cap=enabled \
		-D avif_screenshots=disabled -D input_emulation=disabled -D benchmark=disabled \
		-D enable_openvr_support=false -D enable_tests=false -D enable_zenity=false
	ninja -C build
}

package() {
	meson install -C build --skip-subprojects --destdir "$pkgdir"
	install -Dm644 "gamescope-$pkgver/LICENSE" -t "$pkgdir/usr/share/licenses/$pkgname"
}
