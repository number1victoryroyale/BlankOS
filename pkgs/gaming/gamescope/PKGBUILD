# Maintainer: BlankOS <builds@blankos.invalid>
# Based on Arch Linux's gamescope
#
# Valve's micro-compositor for games: upscaling (FSR/NIS), frame limits,
# HDR and VRR, nested in Plasma (gamescope -- %command% in Steam) or as the
# whole session. wlroots, libliftoff, libdisplay-info, vkroots, reshade,
# SPIRV-Headers, glm and stb are the exact commits gamescope pins (its git
# submodules and wraps), built in as static subprojects. No OpenVR.

pkgname=gamescope
pkgver=3.17.0
pkgrel=1
pkgdesc="SteamOS session compositing window manager"
arch=(x86_64)
url='https://github.com/ValveSoftware/gamescope'
license=('BSD-2-Clause')
depends=('hwdata' 'libcap' 'libdecor' 'libdrm' 'libinput' 'libx11' 'libxcomposite' 'libxcursor' 'libxdamage'
         'libxext' 'libxfixes' 'libxi' 'libxkbcommon' 'libxmu' 'libxrender' 'libxres' 'libxtst' 'libxxf86vm'
         'luajit' 'pipewire' 'pixman' 'sdl2-compat' 'seatd' 'systemd' 'vulkan-icd-loader' 'wayland'
         'xcb-util-wm' 'xorg-xwayland')
makedepends=('cmake' 'glslang' 'meson' 'ninja' 'vulkan-headers' 'wayland-protocols')
_wlroots=d783533489e1f75d6886c2ab5c5960090ef268f8
