_glm=0af55ccecd98d4e5a8d1fad7de25ba429d60e863
_stb=5736b15f7ea0ffb08dd38af21067c314d6a3aae9
source=("gamescope-$pkgver.tar.gz::https://github.com/ValveSoftware/gamescope/archive/refs/tags/$pkgver.tar.gz"
        "https://gitlab.freedesktop.org/wlroots/wlroots/-/archive/$_wlroots/wlroots-$_wlroots.tar.gz"
        "https://gitlab.freedesktop.org/emersion/libliftoff/-/archive/$_liftoff/libliftoff-$_liftoff.tar.gz"
        "https://gitlab.freedesktop.org/emersion/libdisplay-info/-/archive/$_displayinfo/libdisplay-info-$_displayinfo.tar.gz"
        "vkroots-$_vkroots.tar.gz::https://github.com/Joshua-Ashton/vkroots/archive/$_vkroots.tar.gz"
        "reshade-$_reshade.tar.gz::https://github.com/Joshua-Ashton/reshade/archive/$_reshade.tar.gz"
        "SPIRV-Headers-$_spirvheaders.tar.gz::https://github.com/KhronosGroup/SPIRV-Headers/archive/$_spirvheaders.tar.gz"
        "glm-$_glm.tar.gz::https://github.com/g-truc/glm/archive/$_glm.tar.gz"
        "stb-$_stb.tar.gz::https://github.com/nothings/stb/archive/$_stb.tar.gz")
sha256sums=('77d96c2c68c7a98dd4e0b951407fa23dfb4fc30632d5ee740471c7d612f288e0'
            'd4d7c5f4ff5729d5eff33859b58ab7ced812aca54367b75ecbdaf9aae448fff6'
